+"""Prepare, but never apply, current Decision/AnswerCheck fields from raw evidence.
+
+This module deliberately has no `verified` callback, caller-supplied source IDs,
+database session, network client, ready output or ordinary-gate bypass. A future
+dedicated consumer must verify durable receipts and entity/source versions.
+"""
+from __future__ import annotations
+
+from copy import deepcopy
+import json
+import re
+
+from jsonschema import Draft202012Validator
+
+from .correction_pipeline import ANSWER_CHECK_SCHEMA, ID_PATTERN
+from . import scope_recovery_contract as typed
+
+VERSION = "typed-scope-materializer.v1-candidate"
+APPLY_REQUIRED = "typed_scope_apply_required"
+_VERIFICATION = {"mode": "single", "status": "degraded", "independent_readback": False,
+                 "reason_codes": [APPLY_REQUIRED]}
+
+
+def _freeze(value):
+    return typed.FrozenDocument(json.dumps(value, ensure_ascii=False, sort_keys=True,
+                                          separators=(",", ":"), allow_nan=False), typed.digest(value))
+
+
+def _pending(errors, **references):
+    return {"state": "ai_pending", "errors": sorted(set(errors)), "eligible_for_release": False,
+            "application_allowed": False, **references}
+
+
+def _fits(value, maximum, *, nullable=False):
+    return (value is None and nullable) or isinstance(value, str) and 1 <= len(value) <= maximum
+
+
+def _aggregate(checks):
+    verdicts = [check["verdict"] for check in checks]
+    if not verdicts or "unable_to_judge" in verdicts:
+        return "unable_to_judge"
+    if all(verdict == "correct" for verdict in verdicts):
+        return "correct"
+    if all(verdict == "unanswered" for verdict in verdicts):
+        return "unanswered"
+    return "partially_correct" if "correct" in verdicts else "incorrect"
+
+
+def _target_plan(snapshot, target, readback, reviewed):
+    key = target["target_key"]
+    observation = readback["archive"]["observation"]
+    source = readback["source_id"]
+    errors = []
+    if any(not re.fullmatch(ID_PATTERN, value) for value in (
+            target["case_id"], target["question_id"], target["attempt_id"], target["current_decision"]["id"])):
+        errors.append("entity_identity_schema_limit")
+    # The readback response order is not a position order. Sort the host-resolved
+    # original stem offsets; never sort by answer strings or a model index.
+    positions = sorted(readback["positions"], key=lambda position: tuple(position["position_span"]))
+    judgment_by_id = {row["position_id"]: row["judgment"] for row in reviewed["judgments"]}
+    if len(judgment_by_id) != len(positions) or set(judgment_by_id) != {p["position_id"] for p in positions}:
+        return _pending(["materialization_position_mismatch"], source_id=source)
+    checks, position_bindings, answer_lines, method_lines = [], [], [], []
+    for index, position in enumerate(positions, 1):
+        judgment = judgment_by_id[position["position_id"]]
+        status = position["answer_status"]
+        student_answer = position["answer_ref"]["text"] if status == "present" else None
+        explanation = judgment["basis"]
+        if judgment["verdict"] == "incorrect":
+            # These are explicitly labeled model correction fields, NEVER an
+            # inferred replacement/concatenation for the student's answer.
+            explanation += "\n订正：" + judgment["correction_method"]
+            answer_lines.append(f"第{index}处：{judgment['correct_answer']}")
+            method_lines.append(f"第{index}处：{judgment['correction_method']}")
+        elif judgment["verdict"] == "unanswered":
+            answer_lines.append(f"第{index}处：未作答，请完成后复核（未生成标准答案）。")
+            method_lines.append(f"第{index}处尚未作答，请完成该处。")
+        check = {"index": index, "prompt": position["printed_ref"]["text"],
+                 "student_answer": student_answer, "verdict": judgment["verdict"],
+                 "correct_answer": judgment["correct_answer"], "explanation": explanation}
+        if not Draft202012Validator(ANSWER_CHECK_SCHEMA).is_valid(check):
+            errors.append("answer_check_schema_limit")
+        checks.append(check)
+        position_bindings.append({"index": index, "source_id": source,
+                                  **deepcopy(position)})
+    verdict = _aggregate(checks)
+    if verdict != reviewed["proposed_verdict"]:
+        errors.append("aggregate_verdict_mismatch")
+    if observation["answer_status"] == "blank" and verdict != "unanswered":
+        errors.append("aggregate_observation_mismatch")
+    if observation["answer_status"] == "present" and verdict == "unanswered":
+        errors.append("aggregate_observation_mismatch")
+    if verdict == "unable_to_judge":
+        errors.append("unresolved_position_judgment")
+    correct_answer = "\n".join(answer_lines) if verdict in {"incorrect", "partially_correct"} else None
+    # All-unanswered is not an error correction and has no solution/method.
+    correction_method = "\n".join(method_lines) if verdict in {"incorrect", "partially_correct"} else None
+    if not _fits(correct_answer, 1200, nullable=True):
+        errors.append("aggregate_correct_answer_schema_limit")
+    if not _fits(correction_method, 1000, nullable=True):
+        errors.append("aggregate_correction_method_schema_limit")
+    if not _fits(observation["answer_text"], 16000, nullable=True):
+        errors.append("attempt_answer_schema_limit")
+    if not _fits(observation["stem_text"], 16000):
+        errors.append("question_stem_schema_limit")
+    if not 1 <= len(checks) <= 32:
+        errors.append("answer_check_count_limit")
+    if errors:
+        # Do not expose a usable partial decision or silently omit long slots.
+        # Full original evidence remains in the read/review archives.
+        return _pending(errors, source_id=source, preserved_observation=deepcopy(observation),
+                        unmaterialized_checks=checks, unmaterialized_position_bindings=position_bindings)
+
+    counts = {name: sum(check["verdict"] == name for check in checks)
+              for name in ("correct", "incorrect", "unanswered")}
+    summary = (f"模型逐位置复核的结构化候选：共{len(checks)}处，{counts['correct']}处正确，"
+               f"{counts['incorrect']}处错误，{counts['unanswered']}处未作答。尚待持久任务和当前版本核验。")
+    fields = {"case_id": target["case_id"], "origin": "model", "validity": "needs_review",
+              "verdict": verdict, "reason_code": None,
+              "basis": [{"kind": "model_hypothesis", "summary": summary,
+                         "source_ref": source, "regions": []}],
+              "first_error_region": None, "confirmation_source": None,
+              "confirmed_by": None, "confirmed_at": None,
+              "replaces_decision_id": target["current_decision"]["id"], "invalidated_by_event_id": None,
+              "knowledge_points": [], "uncertainties": [], "answer_checks": checks,
+              "correct_answer": correct_answer, "correction_method": correction_method,
+              # A single pure function cannot prove a blind request happened.
+              # Keep ordinary persistence/learning guards closed, even if a
+              # caller accidentally passes this field set into the old flow.
+              "verification": deepcopy(_VERIFICATION)}
+    preconditions = {name: deepcopy(target[name]) for name in (
+        "case_id", "question_id", "question_revision", "attempt_id", "attempt_revision",
+        "attempt_recognition_revision", "current_decision", "input_versions")}
+    preconditions.update(input_snapshot_sha256=snapshot.sha256,
+                         baseline_source_ids=[source["source_id"] for source in target["baseline_sources"]])
+    return {"state": "prepared_application", "errors": [], "eligible_for_release": False,
+            "application_allowed": False, "source_id": source, "preconditions": preconditions,
+            "question_fields": {"stem_text": observation["stem_text"], "options": deepcopy(observation["options"])},
+            "attempt_fields": {"answer_text": observation["answer_text"], "answer_status": observation["answer_status"],
+                               "recognition_uncertainties": deepcopy(observation["uncertainties"])},
+            "decision_fields": fields, "position_bindings": position_bindings,
+            "new_entity_ids_allocated": False, "input_versions_recomputed": False,
+            "answer_slots_modified": False, "recognition_status_ready": False}
+
+
+def prepare_application(snapshot: typed.FrozenDocument, *, read_receipt: dict, read_raw_json: str,
+                        review_receipt: dict, review_raw_json: str) -> typed.FrozenDocument:
+    """Revalidate immutable raw inputs and prepare fields for a dedicated apply.
+
+    No derived `validated_candidate`, source list, boolean approval or callback
+    is accepted. IDs/timestamps/new version fingerprints are deliberately absent
+    from Decision fields: only the future transaction can safely allocate them.
+    """
+    read_request = typed.blind_read_request(snapshot)
+    readback = typed.validate_readback(snapshot, read_request, read_receipt, read_raw_json)
+    read_data = readback.payload()
+    snap = snapshot.payload()
+    reviewable = any(row["state"] == "pending_scope_review" for row in read_data["targets"].values())
+    reviewed = None
+    if reviewable:
+        review_request = typed.scope_review_request(snapshot, readback)
+        reviewed = typed.validate_scope_review(snapshot, readback, review_request, review_receipt, review_raw_json)
+    review_data = reviewed.payload() if reviewed else {"targets": {}}
+    outcomes = {}
+    for target in snap["targets"]:
+        key = target["target_key"]
+        read_target = read_data["targets"][key]
+        review_target = review_data["targets"].get(key)
+        if read_target["state"] != "pending_scope_review":
+            outcomes[key] = _pending(read_target["errors"])
+        elif review_target is None or review_target["state"] != "validated_candidate":
+            outcomes[key] = _pending(review_target["errors"] if review_target else ["missing_typed_review"])
+        else:
+            outcomes[key] = _target_plan(snapshot, target, read_target, review_target)
+    return _freeze({"protocol": VERSION, "kind": "scope_application_plan", "targets": outcomes,
+                    "eligible_for_release": False, "application_allowed": False,
+                    "provenance": {"typed_protocol": typed.PROTOCOL, "input_snapshot_sha256": snapshot.sha256,
+                        "parent_job_id": snap["parent_job_id"], "recovery_job_id": snap["recovery_job_id"],
+                        "asset_id": snap["asset_id"], "image_sha256": snap["image_sha256"],
+                        "read_receipt_id": read_data["receipt"]["receipt_id"],
+                        "readback_sha256": readback.sha256,
+                        "review_receipt_id": review_data.get("receipt", {}).get("receipt_id"),
+                        "review_archive_sha256": reviewed.sha256 if reviewed else None,
+                        "blind_read_contract_bound": True, "blind_read_execution_verified": False,
+                        "provider_origin_verified": False, "image_fidelity_verified": False,
+                        "durable_budget_verified": False, "database_versions_rechecked": False},
+                    "requires_dedicated_apply": True, "ordinary_scope_gate_bypassed": False,
+                    "knowledge_projection_performed": False, "business_writes_performed": False})
