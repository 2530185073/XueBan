+"""Private, MockTransport-only scope consumer; never a production dispatcher.
+
+Exercise the same bounded HTTP and candidate parser as ordinary Chat calls,
+but refuse real transports and use a fixed non-routable provider configuration.
+Only actual mock HTTP request/response boundaries create the wire receipts.
+This proves plumbing, not handwriting accuracy or a production provider call.
+"""
+from __future__ import annotations
+
+import base64
+from dataclasses import asdict, replace
+from datetime import datetime, timezone
+import hashlib
+import json
+import time
+
+import httpx
+from sqlalchemy.orm import Session
+
+from .correction_models import Asset, Task
+from .providers.ark import ArkSettings, Metadata, OutputDiagnostic, ProviderError, _validator
+from .providers.bounded_chat import BoundedChatClient
+from .providers.correction_pipeline import _contains_credential
+from .providers.prompts import COMMON_PROMPT, Role
+from .providers import scope_recovery_contract as typed
+
+
+def _canonical(value):
+    return json.dumps(value, ensure_ascii=False, sort_keys=True,
+                      separators=(",", ":"), allow_nan=False)
+
+
+def _sha(raw):
+    return hashlib.sha256(raw).hexdigest()
+
+
+class _ObservedStream(httpx.AsyncByteStream):
+    def __init__(self, response, observed):
+        self.response, self.observed = response, observed
+
+    async def __aiter__(self):
+        digest = hashlib.sha256()
+        async for chunk in self.response.aiter_bytes():
+            digest.update(chunk)
+            yield chunk
+        self.observed.update(body_complete=True, response_body_sha256=digest.hexdigest())
+
+    async def aclose(self):
+        await self.response.aclose()
+
+
+class MockScopeDispatcher:
+    def __init__(self, store, transport, *, model="synthetic-scope-model", provider_secrets=()):
+        if type(transport) is not httpx.MockTransport:
+            raise ValueError("mock_transport_required")
+        self.store, self.transport, self.model = store, transport, model
+        self.secrets = ("synthetic-scope-key", *tuple(provider_secrets))
+        if any(not isinstance(secret, str) or not secret for secret in self.secrets):
+            raise ValueError("invalid_secret_set")
+
+    def _image(self, state):
+        with Session(self.store.engine) as session:
+            asset = session.get(Asset, state["inputs"]["asset_id"])
+            if asset is None or self.store.asset_reader is None:
+                raise ProviderError("invalid_input")
+            raw = self.store.asset_reader(asset.id, dict(asset.document))
+            mime = asset.document.get("mime_type", asset.document.get("content_type", "image/png"))
+        if (not isinstance(raw, bytes) or not raw or mime not in {"image/png", "image/jpeg", "image/webp"}
+                or _sha(raw) != state["inputs"]["image_sha256"]):
+            raise ProviderError("image_integrity_mismatch")
+        if len(raw) > 4_194_304:
+            raise ProviderError("invalid_input")
+        return raw, "data:" + mime + ";base64," + base64.b64encode(raw).decode("ascii")
+
+    def dispatch(self, task_id, token, stage):
+        if stage not in {"read", "review"}:
+            raise ValueError("invalid_stage")
+        prepared = self.store.prepare_stage(task_id, stage)
+        state = self.store.inspect(task_id)
+        with Session(self.store.engine) as session:
+            task = session.get(Task, task_id)
+            if task is None or task.status != "running" or task.lease_token != token or task.lease_expires_at is None:
+                raise ProviderError("lease_not_current")
+            lease_end = task.lease_expires_at
+        if lease_end.tzinfo is None:
+            lease_end = lease_end.replace(tzinfo=timezone.utc)
+        page_end = datetime.fromisoformat(state["inputs"]["deadline_at"].replace("Z", "+00:00"))
+        remaining = min((lease_end - self.store.clock()).total_seconds(),
+                        (page_end - self.store.clock()).total_seconds())
+        if remaining <= 1:
+            raise ProviderError("deadline_exceeded")
+        request = prepared["request"]
+        image_bytes, data_url = self._image(state)
+        maximum = state["inputs"]["stage_limits"][stage + "_max_tokens"]
+        role = Role.RECOGNITION if stage == "read" else Role.CHECK
+        # The contract prompt and source data are kept in separate messages.
+        # The complete outgoing payload, including the common policy and image,
+        # receives an additional digest independent of the typed prompt digest.
+        body = {"model": self.model,
+                "messages": [
+                    {"role": "system", "content": COMMON_PROMPT + "\n" + request["prompt"]
+                     + "\nJSON Schema:\n" + _canonical(request["schema"])},
+                    {"role": "user", "content": [
+                        {"type": "text", "text": _canonical(request["input"])},
+                        {"type": "image_url", "image_url": {"url": data_url}}]}],
+                "stream": False, "temperature": 0, "max_tokens": maximum,
+                "thinking": {"type": "disabled"}, "response_format": {"type": "json_object"}}
+        settings = ArkSettings(base_url="https://scope-recovery.invalid/v1", api_key=self.secrets[0],
+                               model=self.model, max_attempts=1, max_tokens=maximum,
+                               timeout_seconds=min(20, remaining), total_timeout_seconds=min(30, remaining))
+        # HTTPX's encoder is used both here and by the actual bounded adapter;
+        # do not hash a differently formatted logical JSON object as wire bytes.
+        wire_bytes = httpx.Request("POST", settings.base_url + "/chat/completions", json=body).content
+        body_sha = _sha(wire_bytes)
+        reservation = {key: prepared[key] for key in (
+            "request_contract_sha256", "prompt_sha256", "schema_sha256", "target_keys")}
+        reservation.update(model=self.model, max_output_tokens=maximum,
+                           request_payload_sha256=body_sha, actual_image_sha256=_sha(image_bytes))
+        if stage == "review":
+            reservation.update(read_receipt_id=state["audit"]["scope_stages"]["read"]["receipt"]["receipt_id"],
+                               observation_source_ids=[row["source_id"] for row in request["input"]["targets"]])
+        # Validate configuration/schema before consuming the one-shot slot.
+        validator = _validator(request["schema"])
+        observed = {"body_complete": False, "response_body_sha256": None, "wire_seen": False}
+        receipt = None
+
+        async def guarded(actual):
+            # This executes only when HTTPX dispatches through MockTransport.
+            # Never accept a caller's asserted hash in lieu of these bytes.
+            if observed["wire_seen"]:
+                raise ProviderError("unexpected_repeat_dispatch")
+            observed["wire_seen"] = True
+            raw = actual.content
+            try:
+                decoded = json.loads(raw)
+                actual_image = decoded["messages"][1]["content"][1]["image_url"]["url"]
+                image_hash = _sha(base64.b64decode(actual_image.split(",", 1)[1], validate=True))
+                actual_input = json.loads(decoded["messages"][1]["content"][0]["text"])
+            except (ValueError, TypeError, KeyError, IndexError):
+                raise ProviderError("wire_binding_invalid") from None
+            if (raw != wire_bytes or decoded != body or actual_image != data_url
+                    or image_hash != _sha(image_bytes) or actual_input != request["input"]
+                    or actual.method != "POST" or str(actual.url) != settings.base_url + "/chat/completions"):
+                raise ProviderError("wire_binding_invalid")
+            evidence = {"protocol": "scope-wire.mock.v1", "transport_kind": "httpx_mock",
+                        "receipt_id": receipt["receipt_id"], "stage": "scope_" + stage,
+                        "role": role.value, "request_body_sha256": _sha(raw),
+                        "request_contract_sha256": prepared["request_contract_sha256"],
+                        "input_sha256": typed.digest(actual_input),
+                        "prompt_sha256": prepared["prompt_sha256"],
+                        "schema_sha256": prepared["schema_sha256"],
+                        "actual_image_sha256": image_hash, "model": decoded["model"],
+                        "max_output_tokens": decoded["max_tokens"]}
+            self.store.record_wire(task_id, token, stage, receipt["receipt_id"], evidence)
+            response = await self.transport.handle_async_request(actual)
+            return httpx.Response(response.status_code, headers=response.headers,
+                                  stream=_ObservedStream(response, observed), request=actual)
+
+        with BoundedChatClient(settings, transport=httpx.MockTransport(guarded)) as client:
+            receipt = self.store.reserve_stage(task_id, token, stage, reservation)["receipt"]
+            started = time.monotonic()
+            raw_final = None
+            try:
+                result = client._generate(body, role, validator, started, started + settings.total_timeout_seconds)
+                if any(_contains_credential(result.data, secret)
+                       or _contains_credential(asdict(result.metadata), secret) for secret in self.secrets):
+                    raise ProviderError("provider_credential_echo", attempts=result.metadata.attempts,
+                                        latency_ms=result.metadata.latency_ms)
+                metadata = result.metadata
+                raw_final = _canonical(result.data)
+            except ProviderError as error:
+                attempts = error.attempts
+                if error.code == "provider_credential_echo" or any(
+                        _contains_credential(asdict(attempt), secret) for attempt in attempts for secret in self.secrets):
+                    attempts = tuple(replace(attempt, code="provider_credential_echo", request_id=None, model=None,
+                        diagnostic=OutputDiagnostic("content_security", "credential_echo")) for attempt in attempts)
+                metadata = Metadata(self.model, None, None, None, None, error.latency_ms, attempts)
+            # Unexpected crashes intentionally leave the durable reservation
+            # unknown, never grant a second send or persist exception text.
+            metadata_dict = asdict(metadata)
+            complete = bool(observed["body_complete"] and raw_final is not None)
+            trace = {"protocol": "scope-response.mock.v1", "transport_kind": "httpx_mock",
+                     "receipt_id": receipt["receipt_id"], "request_body_sha256": body_sha,
+                     "response_body_sha256": observed["response_body_sha256"],
+                     "canonical_final_sha256": _sha(raw_final.encode()) if raw_final is not None else None,
+                     "metadata_sha256": typed.digest(metadata_dict), "transport_complete": complete}
+            return self.store.record_return(task_id, token, stage, receipt["receipt_id"],
+                metadata=metadata_dict, raw_final=raw_final, transport_complete=complete,
+                response_evidence=trace)
