+def historical_evidence_fixture(seed, legacy_shared):
+    """Synthetic earlier usable readings exercise real projector/withdrawal logic.
+
+    No provider truth is inferred. The current scope observation is put back in
+    needs_revision before the child is created; only persisted historical learning
+    evidence survives to test recovery's exact invalidation boundary.
+    """
+    flow, case_doc = seed.flow, seed.cases[0]
+    prepare_latest_math_curriculum(flow)
+    with Session(flow.database.engine) as session, session.begin():
+        question = session.get(Entity, case_doc["question_id"])
+        question.document = {**question.document, "subject": "数学", "recognition_uncertainties": []}
+        current = session.get(Entity, case_doc["current_attempt_id"])
+        decision = session.get(Entity, case_doc["current_decision"]["id"])
+        previous_doc = {**deepcopy(current.document), "id": new_id("attempt"),
+                        "recognition_status": "ready", "recognition_uncertainties": [],
+                        "occurred_at": "2026-10-20T01:00:00Z"}
+        previous_doc["root_attempt_id"] = previous_doc["id"]
+        previous = save_entity(session, flow.worker.contracts, flow.homework_id, "attempt", previous_doc)
+        current.document = {**current.document, "recognition_status": "ready", "recognition_uncertainties": [],
+                            "parent_attempt_id": previous.id, "root_attempt_id": previous.id}
+        usable = {**decision.document, "verdict": "incorrect", "validity": "candidate", "reason_code": None,
+                  "uncertainties": [], "knowledge_points": [], "verification": {
+                      "mode": "two_model", "status": "matched", "independent_readback": True, "reason_codes": []}}
+        decision.document = usable
+        previous_decision_doc = {**deepcopy(usable), "id": new_id("decision"), "revision": 1,
+                                "created_at": "2026-10-20T01:00:10Z"}
+        previous_decision_doc["input_versions"]["attempt_id"] = previous.id
+        previous_decision = save_entity(session, flow.worker.contracts, flow.homework_id, "decision", previous_decision_doc)
+        case = session.get(Entity, case_doc["id"])
+        case.document = {**case.document, "attempt_ids": [previous.id, current.id],
+                         "current_decision": deepcopy(decision.document)}
+        def mapping(attempt, source_decision):
+            return QuestionKnowledgeLink(id=new_id("qkl"), tenant_id="tenant_a", student_id="student_a",
+                homework_id=flow.homework_id, question_id=question.id, question_revision=question.revision,
+                graph_version="test-bnup-math-g7-latest", knowledge_id="kp-rational-add-sub", source="model",
+                role="primary", status="confirmed", rationale="合成历史识读归因测试。", created_at=now(),
+                observation_bindings=[observation_binding(attempt, source_decision)])
+        first_link = mapping(previous, previous_decision)
+        if legacy_shared:
+            first_link.observation_bindings = [
+                observation_binding(previous, previous_decision, basis="legacy_evidence"),
+                observation_binding(current, decision, basis="legacy_evidence")]
+            links = [first_link]
+        else:
+            links = [first_link, mapping(current, decision)]
+        staff = QuestionKnowledgeLink(id=new_id("qkl"), tenant_id="tenant_a", student_id="student_a",
+            homework_id=flow.homework_id, question_id=question.id, question_revision=question.revision,
+            graph_version="test-bnup-math-g7-latest", knowledge_id="kp-rational-mul-div", source="staff",
+            role="primary", status="rejected", rationale="合成既有老师驳回归因。", created_at=now())
+        session.add_all([*links, staff]); session.flush()
+        project_student(session, "tenant_a", "student_a")
+        evidence = session.scalars(select(LearningEvidence).where(LearningEvidence.validity == "valid")).all()
+        assert len(evidence) == 2
+        snapshots = {row.document["attempt_id"]: (row.id, row.source_key, deepcopy(row.document)) for row in evidence}
+        # Reopen just this original recognition for scope recovery; keep the
+        # earlier evidence persisted so the recovery transaction must retire it.
+        current.document = {**current.document, "recognition_status": "needs_revision",
+                            "recognition_uncertainties": [answer_scope.SUMMARY]}
+        session.flush()
+        for row in [*links, staff]:
+            session.refresh(row)  # compare persisted DB values, including SQLite UTC storage
+        return {"previous_attempt": previous.id, "previous_decision": row_values(previous_decision),
+                "previous_document": deepcopy(previous.document), "question": deepcopy(question.document),
+                "evidence": snapshots, "original_links": {row.id: row_values(row) for row in [*links, staff]},
+                "current_link_id": links[-1].id, "staff_id": staff.id}
+
