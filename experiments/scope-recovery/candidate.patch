+def request(store, child, stage='read', keys=None):
+    prepared=store.prepare_stage(child,stage)
+    body=prepared.pop('request');prepared.pop('wire_expected',None)
+    prepared.update(request_payload_sha256='b'*64,model='synthetic.model',max_output_tokens=1024,actual_image_sha256=store.inspect(child)['inputs']['image_sha256'])
+    if keys is not None:prepared['target_keys']=keys
+    if stage=='review':
+        prepared.update(read_receipt_id=store.inspect(child)['audit']['scope_stages']['read']['receipt']['receipt_id'],
+                        observation_source_ids=[row['source_id'] for row in body['input']['targets']])
+    return prepared
+
+
+def reserve(store,child,token,stage,req):
+    permit=store.reserve_stage(child,token,stage,req)
+    prepared=store.prepare_stage(child,stage);receipt=permit['receipt']
+    wire={'protocol':'scope-wire.mock.v1','transport_kind':'httpx_mock',
+        'request_body_sha256':req['request_payload_sha256'],'request_contract_sha256':prepared['request_contract_sha256'],
+        'input_sha256':prepared['wire_expected']['input_sha256'],'prompt_sha256':prepared['prompt_sha256'],
+        'schema_sha256':prepared['schema_sha256'],'actual_image_sha256':req['actual_image_sha256'],
+        'model':req['model'],'max_output_tokens':req['max_output_tokens'],'stage':'scope_'+stage,
+        'role':'recognition' if stage=='read' else 'check','receipt_id':receipt['receipt_id']}
+    store.record_wire(child,token,stage,receipt['receipt_id'],wire)
+    return permit
+
+
+def returned(store,child,token,stage,receipt_id,**kwargs):
+    slot=store.inspect(child)['audit']['scope_stages'][stage]
+    raw=kwargs.get('raw_final');complete=kwargs.get('transport_complete',False)
+    kwargs['response_evidence']={'protocol':'scope-response.mock.v1','transport_kind':'httpx_mock',
+        'receipt_id':receipt_id,'request_body_sha256':slot['receipt']['request_payload_sha256'],
+        'response_body_sha256':hashlib.sha256(b'synthetic response envelope').hexdigest(),
+        'canonical_final_sha256':hashlib.sha256(raw.encode()).hexdigest() if raw is not None else None,
+        'metadata_sha256':fingerprint(asdict(kwargs['metadata'])),'transport_complete':complete}
+    return store.record_return(child,token,stage,receipt_id,**kwargs)
+
+
+def metadata():
+    usage=Usage(prompt_tokens=11,completion_tokens=6,total_tokens=17)
+    return Metadata('synthetic.model','synthetic.model','request_one',None,usage,1,(Attempt(1,200,'ok',1,'request_one','synthetic.model',usage),))
+
+
+def quote(text):return {'text':text,'occurrence':1}
+
+
+def read_raw(store,child):
+    rows=[]
+    for target in store.inspect(child)['inputs']['targets']:
+        item=deepcopy(target['baseline_sources'][0]);item.pop('verdict',None)
+        item['answer_text']='-\n4'
+        item['scope_observation']={'coverage':'complete','targets':[
+            {'printed_ref':quote('=____(12÷3)'), 'answer_status':'present','answer_ref':quote('-'),'uncertainty':None},
+            {'printed_ref':quote('(12÷3)=____'),'answer_status':'present','answer_ref':quote('4'),'uncertainty':None}]}
+        rows.append({'target_key':target['target_key'],'observation':item})
+    return json.dumps({'targets':rows},ensure_ascii=False)
+
+
+def review_raw(store,child):
+    read=store.inspect(child)['audit']['scope_stages']['read']['typed_validation']
+    check={'basis':'direct_image','relation':'matches','evidence':'原图位置与引文对应。'}
+    rows=[]
+    for key,value in read['targets'].items():
+        if value['state']!='pending_scope_review':continue
+        positions=[{name:deepcopy(p[name]) for name in ('position_id','printed_ref','answer_ref','answer_status')} |
+          {'printed_position':check,'answer_marks':check,'association':check,
+           'judgment':{'verdict':'correct','reason':'correct','correct_answer':None,'correction_method':None,'basis':'根据原始条件核算。'}}
+          for p in value['positions']]
+        rows.append({'target_key':key,'source_id':value['source_id'],
+          'printed_conditions':{'ref':quote(value['archive']['observation']['stem_text']),'check':check},
+          'coverage':{'status':'complete','check':check},'positions':positions,'remaining_uncertainties':[]})
+    return json.dumps({'targets':rows},ensure_ascii=False)
+
+
+def read_done(store,child,token,keys=None):
+    receipt=reserve(store,child,token,'read',request(store,child,keys=keys))['receipt']
+    returned(store,child,token,'read',receipt['receipt_id'],metadata=metadata(),raw_final=read_raw(store,child),transport_complete=True)
+    sources=[row['source_id'] for row in store.prepare_stage(child,'review')['request']['input']['targets']]
+    return receipt,sources
+
