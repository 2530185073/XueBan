+def evidence(items=None, targets=None):
+    snap = snapshot(targets)
+    read_request = typed.blind_read_request(snap)
+    read_record = receipt(snap, read_request)
+    read_raw = json.dumps({"targets": items or [{"target_key": "r1", "observation": observation()}]}, ensure_ascii=False)
+    readback = typed.validate_readback(snap, read_request, read_record, read_raw)
+    review_request = typed.scope_review_request(snap, readback)
+    review_record = receipt(snap, review_request, readback)
+    review_rows = [review_row(readback, key) for key, value in readback.payload()["targets"].items()
+                   if value["state"] == "pending_scope_review"]
+    return {"snapshot": snap, "read_receipt": read_record, "read_raw_json": read_raw,
+            "review_receipt": review_record, "review_raw_json": json.dumps({"targets": review_rows}, ensure_ascii=False)}
+
+
+def mutate_review(args, change):
+    result = deepcopy(args)
+    raw = json.loads(result["review_raw_json"])
+    change(raw["targets"])
