+        inherited = session.get(QuestionKnowledgeLink, change["inherited_link_id"])
+        assert inherited.question_revision == original["question_revision"] + 1
+        assert inherited.status == status and inherited.source == "staff" and inherited.supersedes_id == staff["id"]
+        assert inherited.actor_id is None and inherited.observation_bindings is None
+        assert inherited.rationale.startswith("[recognition_notes_inheritance:scope.v1]")
+        assert "不代表新增老师操作" in inherited.rationale
+        valid = session.scalars(select(LearningEvidence).where(LearningEvidence.validity == "valid")).all()
+        assert len(valid) == (1 if status == "confirmed" else 0)
+        if valid:
+            assert valid[0].document["link_id"] == inherited.id
+            assert valid[0].document["source_role"] == "model" and valid[0].document["independent"] is False
+            assert valid[0].document["result"] == "correct"
