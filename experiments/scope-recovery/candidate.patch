+"""Pure typed scope recovery contracts. No dispatch, database writes or release.
+
+Host receipts are bindings, not proof of a paid request, a live lease, current
+database versions or image fidelity. Even a fully reviewed candidate cannot be
+fed through the ordinary review gate. A future dedicated apply operation must
+recheck durable provenance and all current versions before consuming it.
+"""
+from __future__ import annotations
+
+from copy import deepcopy
+from dataclasses import dataclass, field
+import hashlib
+import json
+import re
+from typing import Any
+
+from jsonschema import Draft202012Validator
+
+from .answer_scope import candidate_positions, scope_gap
+from .question_units import VISIBLE_LOCATOR_SCHEMA
+from .reconciliation import source_id as legacy_source_id
+from .whole_page import canonical_label, normalize_page_stem
+
+PROTOCOL = "typed-scope-recovery.v1-candidate"
+MAX_TARGETS = 6
+MAX_POSITIONS = 24
+MAX_OUTPUT_BYTES = 262144
+
+
+class ContractError(ValueError):
+    """Fixed diagnostic codes only; never echo provider text in exceptions."""
+
+
+def _canonical(value: Any) -> str:
+    try:
+        return json.dumps(value, ensure_ascii=False, sort_keys=True,
+                          separators=(",", ":"), allow_nan=False)
+    except (TypeError, ValueError, OverflowError):
+        raise ContractError("invalid_json_value") from None
+
+
+def digest(value: Any) -> str:
+    return hashlib.sha256(_canonical(value).encode("utf-8")).hexdigest()
+
+
+@dataclass(frozen=True)
+class FrozenDocument:
+    # Archives contain student work. Suppress repr; callers must persist only to
+    # an authorized private evidence store, never generic logs/task summaries.
+    frozen_json: str = field(repr=False)
+    sha256: str
+
+    def payload(self) -> dict:
+        try:
+            value = json.loads(self.frozen_json)
+        except (ValueError, TypeError):
+            raise ContractError("frozen_document_invalid") from None
+        if not isinstance(value, dict) or digest(value) != self.sha256:
+            raise ContractError("frozen_document_changed")
+        return value
+
+
+def _freeze(value: dict) -> FrozenDocument:
+    return FrozenDocument(_canonical(value), digest(value))
+
+
+def _obj(properties):
+    return {"type": "object", "additionalProperties": False,
+            "properties": properties, "required": list(properties)}
+
+
+def _text(maximum=1200):
+    return {"type": "string", "minLength": 1, "maxLength": maximum}
+
+
+def _nullable(schema):
+    return {"anyOf": [schema, {"type": "null"}]}
+
+
+def _list(schema, maximum, minimum=0):
+    return {"type": "array", "items": schema, "minItems": minimum, "maxItems": maximum}
+
+
+QUOTE = _obj({"text": _text(), "occurrence": {"type": "integer", "minimum": 1, "maximum": 80}})
+FULL_QUOTE = _obj({"text": _text(8000), "occurrence": {"const": 1}})
+SLOT = _obj({"printed_ref": QUOTE, "answer_status": {"enum": ["present", "blank", "unclear"]},
+             "answer_ref": _nullable(QUOTE), "uncertainty": _nullable(_text(300))})
+SCOPE = _obj({"coverage": {"enum": ["complete", "partial", "uncertain"]},
+              "targets": _list(SLOT, MAX_POSITIONS)})
+OBSERVATION = _obj({"label": _text(120), "stem_text": _text(8000),
+                    "options": _list(_obj({"label": _text(20), "text": _text(2000)}), 16),
+                    "answer_text": _nullable(_text(8000)),
+                    "answer_status": {"enum": ["present", "blank", "unclear"]},
+                    "uncertainties": _list(_text(300), 24),
+                    "visible_locator": deepcopy(VISIBLE_LOCATOR_SCHEMA), "scope_observation": SCOPE})
+READ_ROW = _obj({"target_key": _text(128), "observation": OBSERVATION})
+READ_SCHEMA = _obj({"targets": _list(READ_ROW, MAX_TARGETS)})
+
+IMAGE_CHECK = _obj({"basis": {"enum": ["direct_image", "inferred", "unresolved"]},
+                    "relation": {"enum": ["matches", "differs", "uncertain"]}, "evidence": _text(600)})
+JUDGMENT = _obj({"verdict": {"enum": ["correct", "incorrect", "unanswered", "unable_to_judge"]},
+                 "reason": {"enum": ["correct", "knowledge_gap", "calculation_error", "copy_error",
+                                       "unanswered", "model_disagreement", "visual_unreadable"]},
+                 "correct_answer": _nullable(_text()), "correction_method": _nullable(_text()),
+                 "basis": _text(1200)})
+REVIEW_POSITION = _obj({"position_id": _text(100), "printed_ref": QUOTE,
+                        "answer_status": {"enum": ["present", "blank", "unclear"]},
+                        "answer_ref": _nullable(QUOTE),
+                        "printed_position": IMAGE_CHECK, "answer_marks": IMAGE_CHECK,
+                        "association": IMAGE_CHECK, "judgment": JUDGMENT})
+REVIEW_ROW = _obj({"target_key": _text(128), "source_id": _text(100),
+                   "printed_conditions": _obj({"ref": FULL_QUOTE, "check": IMAGE_CHECK}),
+                   "coverage": _obj({"status": {"enum": ["complete", "partial", "uncertain"]},
+                                      "check": IMAGE_CHECK}),
+                   "positions": _list(REVIEW_POSITION, MAX_POSITIONS),
+                   "remaining_uncertainties": _list(_text(300), 24)})
+REVIEW_SCHEMA = _obj({"targets": _list(REVIEW_ROW, MAX_TARGETS)})
+
+READ_PROMPT = (
+    "只从原图识读指定题号和区域；标识target_key仅用于回传。看清完整印刷题干、条件和每一处学生笔迹，"
+    "不要解题、判对错或用应有答案补字。不知道原图有几处作答位置时保留uncertain。"
+    "answer_text逐字保留原笔迹，以自然换行保留不同片段；不能为了匹配空数拆开一个数或复制笔迹。"
+    "每个scope_observation.targets引用本次stem_text里一个实际印刷作答位置的连续原文printed_ref，"
+    "以及本次answer_text里对应完整笔迹的answer_ref。ref含text和从1起的重叠字面出现序号occurrence。"
+    "确实未作答用blank和null引用，字迹无法确认用unclear、null引用并说明。"
+    "只有原图整题所有位置都覆盖才声明complete；不要输出答案推理或内部思维。"
+)
+REVIEW_PROMPT = (
+    "逐题对照原图复核新的读回记录；这些记录不是已知正确答案。不得改写、补全、拆分或重新排列原观察。"
+    "source_id、position_id和原printed_ref/answer_ref/status逐字回显。"
+    "分别核对印刷位置、实际笔迹及二者关联，逐项说明direct_image依据；推算的内容不能用作图像证据。"
+    "核对完整印刷题干和条件全文、整题所有位置覆盖；不能用自洽引用或相同空数自证看对。"
+    "任何漏读、笔迹或关联不同、无法确定，保留differs/uncertain和remaining_uncertainties。"
+    "只有图像观察对应后才对每个原位置给数学判定；incorrect须给正确答案和简短订正方法，"
+    "correct/unanswered/unable_to_judge的correct_answer和correction_method为null。"
+    "不要输出整题是否通过的布尔值，不输出内部推理。"
+)
+
+
+def _identifier(value):
+    return isinstance(value, str) and bool(re.fullmatch(r"[A-Za-z0-9_.:-]{1,128}", value))
+
+
+def _sha(value):
+    return isinstance(value, str) and bool(re.fullmatch(r"[0-9a-f]{64}", value))
+
+
+def _positive(value):
+    return type(value) is int and value > 0
+
+
+def freeze_snapshot(*, parent_job_id: str, recovery_job_id: str, asset_id: str,
+                    image_bytes: bytes, targets: list[dict]) -> FrozenDocument:
+    """Host-only immutable version/source snapshot; source bytes are never stored."""
+    if not all(_identifier(value) for value in (parent_job_id, recovery_job_id, asset_id)):
+        raise ContractError("invalid_host_identity")
+    if parent_job_id == recovery_job_id:
+        raise ContractError("parent_is_recovery")
+    if not isinstance(image_bytes, bytes) or not image_bytes:
+        raise ContractError("missing_image_bytes")
+    if not isinstance(targets, list) or not 1 <= len(targets) <= MAX_TARGETS:
+        raise ContractError("target_limit")
+    fields = {"target_key", "case_id", "question_id", "question_revision", "attempt_id", "attempt_revision",
+              "attempt_recognition_revision", "current_decision", "input_versions", "locator", "baseline_sources"}
+    keys = set()
+    attempts = set()
+    for target in targets:
+        if not isinstance(target, dict) or set(target) != fields:
+            raise ContractError("invalid_target_binding")
+        if not all(_identifier(target[name]) for name in ("target_key", "case_id", "question_id", "attempt_id")):
+            raise ContractError("invalid_target_identity")
+        if target["target_key"] in keys or target["attempt_id"] in attempts:
+            raise ContractError("duplicate_target_binding")
+        keys.add(target["target_key"]); attempts.add(target["attempt_id"])
+        if not all(_positive(target[name]) for name in ("question_revision", "attempt_revision", "attempt_recognition_revision")):
+            raise ContractError("invalid_target_revision")
+        decision = target["current_decision"]
+        if (not isinstance(decision, dict) or set(decision) != {"id", "revision"}
+                or not _identifier(decision["id"]) or not _positive(decision["revision"])):
+            raise ContractError("invalid_decision_binding")
+        versions = target["input_versions"]
+        if not isinstance(versions, dict) or not _sha(versions.get("fingerprint")):
+            raise ContractError("missing_input_fingerprint")
+        locator = target["locator"]
+        if not Draft202012Validator(VISIBLE_LOCATOR_SCHEMA).is_valid(locator):
+            raise ContractError("invalid_locator")
+        label = canonical_label(locator["printed_label"] or "")
+        if not re.fullmatch(r"[1-9][0-9]*(?:\([1-9][0-9]*\))?", label):
+            raise ContractError("unsupported_locator_label")
+        sources = target["baseline_sources"]
+        if not isinstance(sources, list) or len(sources) != 2:
+            raise ContractError("missing_baseline_sources")
+        for role, source in zip(("primary", "secondary"), sources):
+            if not isinstance(source, dict) or set(source) != {"role", "source_id", "observation"} or source["role"] != role:
+                raise ContractError("invalid_baseline_source")
+            item = source["observation"]
+            if (not isinstance(item, dict) or canonical_label(item.get("label", "")) != label
+                    or item.get("options", []) != [] or not scope_gap(item)):
+                raise ContractError("baseline_not_supported_scope")
+            if source["source_id"] != legacy_source_id(role, item):
+                raise ContractError("baseline_source_digest_mismatch")
+        if normalize_page_stem(sources[0]["observation"]) != normalize_page_stem(sources[1]["observation"]):
+            raise ContractError("baseline_printed_conditions_disagree")
+    value = {"protocol": PROTOCOL, "kind": "snapshot", "parent_job_id": parent_job_id,
+             "recovery_job_id": recovery_job_id, "asset_id": asset_id,
+             "image_sha256": hashlib.sha256(image_bytes).hexdigest(), "targets": deepcopy(targets)}
+    return _freeze(value)
+
+
+def _snapshot(snapshot):
+    if not isinstance(snapshot, FrozenDocument):
+        raise ContractError("snapshot_required")
+    value = snapshot.payload()
+    if value.get("protocol") != PROTOCOL or value.get("kind") != "snapshot":
+        raise ContractError("snapshot_protocol_mismatch")
+    return value
+
+
+def _request(snapshot, stage, prompt, schema, content):
+    data = _snapshot(snapshot)
+    return _freeze({"protocol": PROTOCOL, "kind": "request", "stage": stage,
+                    "input_snapshot_sha256": snapshot.sha256, "asset_id": data["asset_id"],
+                    "image_sha256": data["image_sha256"], "prompt": prompt,
+                    "schema": deepcopy(schema), "input": content})
+
+
+def blind_read_request(snapshot: FrozenDocument) -> FrozenDocument:
+    data = _snapshot(snapshot)
+    return _request(snapshot, "scope_read", READ_PROMPT, READ_SCHEMA,
+                    {"targets": [{"target_key": target["target_key"], "locator": {
+                        "printed_label": canonical_label(target["locator"]["printed_label"]),
+                        "page_zone": target["locator"]["page_zone"]}}
+                        for target in data["targets"]]})
+
+
+def _receipt(snapshot, request, receipt, stage, *, read_receipt_id=None, source_ids=None):
+    data = _snapshot(snapshot)
+    body = request.payload()
+    fields = {"receipt_id", "stage", "parent_job_id", "recovery_job_id", "asset_id",
+              "input_snapshot_sha256", "request_contract_sha256", "request_payload_sha256",
+              "prompt_sha256", "schema_sha256", "model", "actual_image_sha256", "target_keys",
+              "owner_lease_digest", "transport_complete"}
+    if stage == "scope_review":
+        fields |= {"read_receipt_id", "observation_source_ids"}
+    if not isinstance(receipt, dict) or set(receipt) != fields:
+        raise ContractError("invalid_receipt_shape")
+    expected = {"stage": stage, "parent_job_id": data["parent_job_id"], "recovery_job_id": data["recovery_job_id"],
+                "asset_id": data["asset_id"], "input_snapshot_sha256": snapshot.sha256,
+                "request_contract_sha256": request.sha256, "actual_image_sha256": data["image_sha256"],
+                "prompt_sha256": digest(body["prompt"]), "schema_sha256": digest(body["schema"]),
+                "target_keys": [item["target_key"] for item in body["input"]["targets"]]}
+    if any(receipt.get(key) != value for key, value in expected.items()):
+        raise ContractError("receipt_binding_mismatch")
+    if (not _identifier(receipt["receipt_id"]) or not _sha(receipt["request_payload_sha256"])
+            or not _sha(receipt["owner_lease_digest"]) or not isinstance(receipt["model"], str)
+            or not receipt["model"].strip() or len(receipt["model"]) > 200):
+        raise ContractError("invalid_receipt_metadata")
+    if receipt["transport_complete"] is not True:
+        raise ContractError("transport_incomplete")
+    if stage == "scope_review" and (receipt["read_receipt_id"] != read_receipt_id
+            or receipt["receipt_id"] == read_receipt_id or receipt["observation_source_ids"] != source_ids):
+        raise ContractError("review_receipt_binding_mismatch")
+    return deepcopy(receipt)
+
+
+def _parse(raw_payload):
+    # The host passes ONLY final JSON text, not a response envelope/reasoning.
+    # Credential scanning and private storage are host transport obligations.
+    if not isinstance(raw_payload, str) or len(raw_payload.encode("utf-8")) > MAX_OUTPUT_BYTES:
+        raise ContractError("invalid_output_size")
+    def unique(pairs):
+        result = {}
+        for key, value in pairs:
+            if key in result:
+                raise ContractError("duplicate_json_key")
+            result[key] = value
+        return result
+    def nonfinite(_):
+        raise ContractError("nonfinite_json")
+    try:
+        value = json.loads(raw_payload, object_pairs_hook=unique, parse_constant=nonfinite)
+    except ContractError:
+        raise
+    except (ValueError, TypeError, RecursionError):
+        raise ContractError("invalid_final_json") from None
+    if not isinstance(value, dict) or set(value) != {"targets"} or not isinstance(value["targets"], list):
+        raise ContractError("invalid_output_envelope")
+    if len(value["targets"]) > MAX_TARGETS:
+        raise ContractError("output_target_limit")
+    return value
+
+
+def quote_span(container, reference):
+    if not isinstance(container, str) or not Draft202012Validator(QUOTE).is_valid(reference):
+        raise ContractError("invalid_quote")
+    spans = [(match.start(), match.start() + len(reference["text"]))
+             for match in re.finditer("(?=" + re.escape(reference["text"]) + ")", container)]
+    if reference["occurrence"] > len(spans):
+        raise ContractError("quote_not_bound")
+    return spans[reference["occurrence"] - 1]
+
+
+def _pending(*errors):
+    return {"state": "ai_pending", "errors": sorted(set(errors)), "eligible_for_release": False}
+
+
+def _read_target(snapshot, target, row, receipt):
+    if not Draft202012Validator(READ_ROW).is_valid(row):
+        return _pending("read_schema_invalid")
+    observation = row["observation"]
+    errors = []
+    if any(canonical_label(observation["label"]) != canonical_label(source["observation"]["label"])
+           for source in target["baseline_sources"]):
+        errors.append("original_target_changed")
+    if (canonical_label(observation["visible_locator"]["printed_label"] or "")
+            != canonical_label(target["locator"]["printed_label"])
+            or observation["visible_locator"]["page_zone"] != target["locator"]["page_zone"]):
+        errors.append("original_locator_changed")
+    if any(normalize_page_stem(observation) != normalize_page_stem(source["observation"])
+           or observation["options"] != source["observation"].get("options", [])
+           for source in target["baseline_sources"]):
+        errors.append("printed_conditions_changed")
+    expected = [match.span() for match in re.finditer(r"[_＿]{2,}(?:\s+[_＿]{2,})*", observation["stem_text"])]
+    if candidate_positions(observation) is None or not 2 <= len(expected) <= MAX_POSITIONS:
+        errors.append("scope_type_not_supported")
+    covered, answer_spans, positions = [], [], []
+    scope = observation["scope_observation"]
+    for slot in scope["targets"]:
+        try:
+            printed = quote_span(observation["stem_text"], slot["printed_ref"])
+            matched = [span for span in expected if printed[0] <= span[0] and span[1] <= printed[1]]
+            if len(matched) != 1:
+                raise ContractError("printed_ref_not_one_position")
+            covered.append(matched[0])
+            answer = None
+            if slot["answer_status"] == "present":
+                answer = quote_span(observation["answer_text"], slot["answer_ref"])
+                if not slot["answer_ref"]["text"].strip():
+                    raise ContractError("empty_answer_quote")
+                answer_spans.append(answer)
+            elif slot["answer_ref"] is not None:
+                raise ContractError("nonpresent_answer_quote")
+            if slot["answer_status"] == "unclear" or slot["uncertainty"]:
+                errors.append("slot_evidence_unresolved")
+            positions.append({"printed_span": printed, "position_span": matched[0], "answer_span": answer,
+                              "printed_ref": deepcopy(slot["printed_ref"]),
+                              "answer_status": slot["answer_status"], "answer_ref": deepcopy(slot["answer_ref"])})
+        except ContractError as error:
+            errors.append(str(error))
+    if len(set(covered)) != len(covered):
+        errors.append("printed_position_reused")
+    if set(covered) != set(expected):
+        errors.append("printed_positions_not_covered")
+    if any(a[0] < b[1] and b[0] < a[1] for index, a in enumerate(answer_spans) for b in answer_spans[index + 1:]):
+        errors.append("answer_fragment_reused")
+    if scope["coverage"] != "complete":
+        errors.append("scope_not_complete")
+    if observation["uncertainties"] or observation["answer_status"] == "unclear":
+        errors.append("source_evidence_unresolved")
+    present = any(slot["answer_status"] == "present" for slot in scope["targets"])
+    if (present and observation["answer_status"] != "present"
+            or not present and (observation["answer_status"] != "blank" or observation["answer_text"] is not None)):
+        errors.append("aggregate_status_conflict")
+    archive = {"protocol": PROTOCOL, "input_snapshot_sha256": snapshot.sha256,
+               "target_key": target["target_key"], "read_receipt": receipt,
+               "observation": deepcopy(observation), "resolved_positions": positions}
+    source_id = "scope_visual:" + digest(archive)
+    # IDs depend on the immutable archive and complete position mapping, not
+    # provider-authored indexes or the expected mathematical answer.
+    identified = [{"position_id": "scope_position:" + digest({"source_id": source_id, "position": position}),
+                   **position} for position in positions]
+    return {"state": "ai_pending" if errors else "pending_scope_review", "errors": sorted(set(errors)),
+            "eligible_for_release": False, "source_id": source_id, "archive": archive,
+            "positions": identified, "count_is_image_truth": False}
+
+
+def _groups(raw, known):
+    groups = {key: [] for key in known}
+    unknown, invalid = [], 0
+    for row in raw["targets"]:
+        if not isinstance(row, dict) or not isinstance(row.get("target_key"), str):
+            invalid += 1
+        elif row["target_key"] not in groups:
+            unknown.append(row["target_key"])
+        else:
+            groups[row["target_key"]].append(row)
+    return groups, unknown, invalid
+
+
+def validate_readback(snapshot: FrozenDocument, request: FrozenDocument, receipt: dict,
+                      raw_payload: str) -> FrozenDocument:
+    """Archive final text + refs. A clean read still needs typed image review."""
+    if request != blind_read_request(snapshot):
+        raise ContractError("read_request_changed")
+    checked_receipt = _receipt(snapshot, request, receipt, "scope_read")
+    raw = _parse(raw_payload)
+    targets = _snapshot(snapshot)["targets"]
+    groups, unknown, invalid = _groups(raw, [target["target_key"] for target in targets])
+    outcomes = {}
+    for target in targets:
+        key = target["target_key"]
+        rows = groups[key]
+        outcomes[key] = (_read_target(snapshot, target, rows[0], checked_receipt) if len(rows) == 1
+                         else _pending("missing_target" if not rows else "duplicate_target"))
+    accepted = [row for row in outcomes.values() if row["state"] == "pending_scope_review"]
+    if sum(len(row["positions"]) for row in accepted) > MAX_POSITIONS:
+        for row in accepted:
+            row.update(_pending("page_position_limit"))
+    return _freeze({"protocol": PROTOCOL, "kind": "readback", "input_snapshot_sha256": snapshot.sha256,
+                    "request_sha256": request.sha256, "receipt": checked_receipt,
+                    "raw_final": raw, "targets": outcomes, "unknown_target_keys": unknown,
+                    "unkeyed_invalid_items": invalid, "eligible_for_release": False,
+                    "dispatch_budget_enforced": False, "image_fidelity_verified": False})
+
+
+def _readback(snapshot, readback):
+    # Recompute, not trust a caller-set state/source_id on a frozen container.
+    data = readback.payload()
+    if data.get("kind") != "readback" or data.get("input_snapshot_sha256") != snapshot.sha256:
+        raise ContractError("readback_binding_mismatch")
+    try:
+        rebuilt = validate_readback(snapshot, blind_read_request(snapshot), data["receipt"], _canonical(data["raw_final"]))
+    except (KeyError, TypeError):
+        raise ContractError("readback_binding_mismatch") from None
+    if rebuilt != readback:
+        raise ContractError("readback_changed")
+    return data
+
+
+def scope_review_request(snapshot: FrozenDocument, readback: FrozenDocument) -> FrozenDocument:
+    data = _readback(snapshot, readback)
+    targets = [{"target_key": key, "source_id": outcome["source_id"],
+                "observation": outcome["archive"]["observation"], "positions": outcome["positions"]}
+               for key, outcome in data["targets"].items() if outcome["state"] == "pending_scope_review"]
+    if not targets:
+        raise ContractError("no_reviewable_targets")
+    return _request(snapshot, "scope_review", REVIEW_PROMPT, REVIEW_SCHEMA, {"targets": targets})
+
+
+def _image_agrees(value):
+    # This validates a model claim; it does not verify actual pixels.
+    return value["basis"] == "direct_image" and value["relation"] == "matches" and bool(value["evidence"].strip())
+
+
+def _review_target(candidate, row):
+    if not Draft202012Validator(REVIEW_ROW).is_valid(row):
+        return _pending("review_schema_invalid")
+    errors = []
+    if row["source_id"] != candidate["source_id"]:
+        errors.append("review_source_changed")
+    observation = candidate["archive"]["observation"]
+    conditions = row["printed_conditions"]
+    if conditions["ref"] != {"text": observation["stem_text"], "occurrence": 1}:
+        errors.append("printed_conditions_quote_changed")
+    if not _image_agrees(conditions["check"]):
+        errors.append("printed_conditions_not_verified")
+    if row["coverage"]["status"] != "complete" or not _image_agrees(row["coverage"]["check"]):
+        errors.append("image_coverage_not_verified")
+    if row["remaining_uncertainties"]:
+        errors.append("review_evidence_unresolved")
+    positions = {position["position_id"]: position for position in candidate["positions"]}
+    reviewed = [position["position_id"] for position in row["positions"]]
+    if len(set(reviewed)) != len(reviewed) or set(reviewed) != set(positions):
+        errors.append("review_positions_not_exact")
+    judgments = []
+    for position in row["positions"]:
+        original = positions.get(position["position_id"])
+        if original is None:
+            continue
+        if any(position[name] != original[name] for name in ("printed_ref", "answer_ref", "answer_status")):
+            errors.append("position_observation_changed")
+        if not all(_image_agrees(position[name]) for name in ("printed_position", "answer_marks", "association")):
+            errors.append("position_image_relation_unverified")
+        judgment = position["judgment"]
+        verdict = judgment["verdict"]
+        allowed = ({"correct", "incorrect"} if original["answer_status"] == "present" else {"unanswered"})
+        if verdict not in allowed:
+            errors.append("position_judgment_unresolved")
+        if verdict == "incorrect":
+            if (judgment["reason"] not in {"knowledge_gap", "calculation_error", "copy_error"}
+                    or not (judgment["correct_answer"] or "").strip()
+                    or not (judgment["correction_method"] or "").strip()):
+                errors.append("invalid_incorrect_judgment")
+        elif (judgment["reason"] != verdict or judgment["correct_answer"] is not None
+              or judgment["correction_method"] is not None):
+            errors.append("invalid_nonerror_judgment")
+        if not judgment["basis"].strip():
+            errors.append("missing_judgment_basis")
+        judgments.append({"position_id": position["position_id"], "judgment": deepcopy(judgment)})
+    verdicts = [item["judgment"]["verdict"] for item in judgments]
+    aggregate = ("correct" if verdicts and all(value == "correct" for value in verdicts)
+                 else "unanswered" if verdicts and all(value == "unanswered" for value in verdicts)
+                 else "partially_correct" if "correct" in verdicts else "incorrect")
+    return {"state": "ai_pending" if errors else "validated_candidate", "errors": sorted(set(errors)),
+            "source_id": candidate["source_id"], "eligible_for_release": False,
+            "judgments": judgments, "proposed_verdict": None if errors else aggregate}
+
+
+def validate_scope_review(snapshot: FrozenDocument, readback: FrozenDocument,
+                          request: FrozenDocument, receipt: dict, raw_payload: str) -> FrozenDocument:
+    """Typed original-image review binding, NOT authorization to apply/ready."""
+    read_data = _readback(snapshot, readback)
+    if request != scope_review_request(snapshot, readback):
+        raise ContractError("review_request_changed")
+    requested = request.payload()["input"]["targets"]
+    checked_receipt = _receipt(snapshot, request, receipt, "scope_review",
+        read_receipt_id=read_data["receipt"]["receipt_id"], source_ids=[row["source_id"] for row in requested])
+    raw = _parse(raw_payload)
+    groups, unknown, invalid = _groups(raw, [row["target_key"] for row in requested])
+    outcomes = {}
+    for key, rows in groups.items():
+        outcomes[key] = (_review_target(read_data["targets"][key], rows[0]) if len(rows) == 1
+                         else _pending("missing_review_target" if not rows else "duplicate_review_target"))
+    archive = {"protocol": PROTOCOL, "kind": "scope_review", "input_snapshot_sha256": snapshot.sha256,
+               "readback_sha256": readback.sha256, "read_receipt_id": read_data["receipt"]["receipt_id"],
+               "receipt": checked_receipt, "raw_final": raw, "targets": outcomes,
+               "unknown_target_keys": unknown, "unkeyed_invalid_items": invalid,
+               "eligible_for_release": False, "image_fidelity_verified": False,
+               "dispatch_budget_enforced": False, "database_versions_rechecked": False, "decision_materialization_complete": False}
+    return _freeze(archive)
