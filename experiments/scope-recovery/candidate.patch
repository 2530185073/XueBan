+"""Actual upload/worker + isolated DB + HTTP MockTransport; no real models.
+
+The initial host manifest is an explicit test-only producer derived from this
+run's actual two mock calls and persisted parent audit. It is not a production
+producer, a historical backfill, or a handwriting gold standard.
+"""
+from copy import deepcopy
+from datetime import timedelta
+import json
+from types import SimpleNamespace
+
+import httpx
+import pytest
+from sqlalchemy import func, select
+from sqlalchemy.orm import Session
+
+from test_correction_flow import flow, teacher  # noqa: F401
+from test_learning import link, prepare_latest_math_curriculum
+from test_partial_output_persistence import make_client
+from test_two_model_pipeline import correct
+from xueban_backend.correction_core import input_versions, new_id, now, save_entity
+from xueban_backend.correction_models import Asset, Entity, EntitySnapshot, Task
+from xueban_backend.learning_models import LearningEvidence, QuestionKnowledgeLink
+from xueban_backend.learning_link_scope import observation_binding
+from xueban_backend.learning_projection import project_student
+from xueban_backend.models import Homework, Student
+from xueban_backend.providers import answer_scope
+from xueban_backend.providers.reconciliation import source_id
+from xueban_backend.providers.two_model import TwoModelWholePagePipeline
+from xueban_backend.scope_recovery import DurableScope, Rejected, HOST_KEY, ROUTE_PROTOCOL, POLICY
+from xueban_backend.scope_recovery_apply import apply_scope_recovery
+from xueban_backend.scope_recovery_dispatch import MockScopeDispatcher
+
+
+def seed_scope(flow, count=1):
+    originals = [correct(str(index + 1), stem_text="(-12)÷3=____(12÷3)=____", answer_text="4",
+                         visible_locator={"printed_label": str(index + 1), "page_zone": "top_left"})
+                 for index in range(count)]
+    first, first_calls = make_client(originals, "synthetic-scope-primary")
+    second, second_calls = make_client(originals, "synthetic-scope-secondary")
+    pipeline = TwoModelWholePagePipeline(first, second)
+    flow.worker.pipeline = pipeline
+    try:
+        asset, parent_job = flow.recognize()
+        assert flow.worker.run_once()
+    finally:
+        pipeline.close()
+    assert len(first_calls) == len(second_calls) == 1
+    with Session(flow.database.engine) as session:
+        parent = session.get(Task, parent_job["id"])
+        assert parent.status == "succeeded" and parent.tries == 1
+        assert len(parent.audit["executions"]) == 1
+        metadata = parent.audit["executions"][0]["metadata"]
+        assert len(metadata["attempts"]) == 2 and all(attempt["code"] == "ok" for attempt in metadata["attempts"])
+        cases = list(session.scalars(select(Entity).where(Entity.homework_id == flow.homework_id, Entity.kind == "case")))
+        cases.sort(key=lambda case: session.get(Entity, case.document["question_id"]).annotations["label"])
+        targets, owned = [], []
+        for index, case in enumerate(cases):
+            raw = originals[index]; key = "target_" + str(index)
+            ids = [source_id(role, raw) for role in ("primary", "secondary")]
+            targets.append({"target_key": key, "case_id": case.id, "baseline_sources": [deepcopy(raw), deepcopy(raw)],
+                            "baseline_source_ids": ids, "locator": deepcopy(raw["visible_locator"])})
+            owned.append({"target_key": key, "canonical_label": raw["label"], "source_ids": ids})
+        dispatches = [{"receipt_ref": f"this_test_parent_actual_{stage}", "stage": stage,
+                       "requested_target_keys": [target["target_key"] for target in targets], "outcome": "returned"}
+                      for stage in ("primary", "secondary")]
+        route = {"protocol": ROUTE_PROTOCOL, "asset_id": asset["id"], "image_sha256": asset["sha256"],
+                 "parent_execution_number": 1, "policy": deepcopy(POLICY), "scope_owned": owned,
+                 "legacy_dispatches": dispatches, "review_budget": {"limit": 2, "receipts": [], "scope_reserved_for_child": None}}
+        parent.audit = {**deepcopy(parent.audit), HOST_KEY: {asset["id"]: {"route_manifest": route, "targets": targets}}}
+        saved_cases = [deepcopy(case.document) for case in cases]
+        session.commit()
+    return SimpleNamespace(flow=flow, asset=asset, parent=parent_job["id"], cases=saved_cases,
+                           originals=originals, parent_http_calls=2)
+
+
+def start(seed):
+    seed.store = DurableScope(seed.flow.database.engine, asset_reader=seed.flow.worker.store.read)
+    seed.child = seed.store.create_for_completed_page(seed.parent, seed.asset["id"])["task_id"]
+    seed.token = seed.store.claim(seed.child)
+    assert seed.token
+    return seed
+
+
+def quoted(text):
+    return {"text": text, "occurrence": 1}
+
+
+def observed_input(target):
+    label = target["locator"]["printed_label"]
+    return {"label": label, "stem_text": "(-12)÷3=____(12÷3)=____", "options": [],
+            "answer_text": "-\n-4", "answer_status": "present", "uncertainties": [],
+            "visible_locator": target["locator"], "scope_observation": {"coverage": "complete", "targets": [
+                {"printed_ref": quoted("=____(12÷3)"), "answer_status": "present", "answer_ref": quoted("-"), "uncertainty": None},
+                {"printed_ref": quoted("(12÷3)=____"), "answer_status": "present", "answer_ref": quoted("-4"), "uncertainty": None}]}}
+
+
+def reviewed_input(target):
+    check = {"basis": "direct_image", "relation": "matches", "evidence": "合成Mock图像关系，仅用于验证数据流。"}
+    positions = []
+    for p in target["positions"]:
+        verdict = "unanswered" if p["answer_status"] == "blank" else "correct"
+        positions.append({name: deepcopy(p[name]) for name in ("position_id", "printed_ref", "answer_ref", "answer_status")} |
+                         {"printed_position": check, "answer_marks": check, "association": check,
+                          "judgment": {"verdict": verdict, "reason": verdict, "correct_answer": None,
+                                       "correction_method": None, "basis": "合成逐位置判定。"}})
+    return {"target_key": target["target_key"], "source_id": target["source_id"],
+            "printed_conditions": {"ref": quoted(target["observation"]["stem_text"]), "check": check},
+            "coverage": {"status": "complete", "check": check}, "positions": positions, "remaining_uncertainties": []}
+
+
+def dispatch_both(seed, transform=None):
+    calls = []
+    def serve(request):
+        body = json.loads(request.content)
+        content = json.loads(body["messages"][1]["content"][0]["text"])
+        stage = "review" if "source_id" in content["targets"][0] else "read"
+        calls.append({"stage": stage, "targets": deepcopy(content["targets"])})
+        data = {"targets": [reviewed_input(target) if stage == "review" else
+                            {"target_key": target["target_key"], "observation": observed_input(target)}
+                            for target in content["targets"]]}
+        if transform: transform(stage, data)
+        return httpx.Response(200, json={"id": "mock_scope", "model": "synthetic-scope-model",
+            "choices": [{"finish_reason": "stop", "message": {"content": json.dumps(data, ensure_ascii=False)}}],
+            "usage": {"prompt_tokens": 20, "completion_tokens": 30, "total_tokens": 50}})
+    dispatcher = MockScopeDispatcher(seed.store, httpx.MockTransport(serve))
+    for stage in ("read", "review"):
+        outcome = dispatcher.dispatch(seed.child, seed.token, stage)
+        assert outcome["recorded"] and not outcome["late"], seed.store.inspect(seed.child)
+    assert [call["stage"] for call in calls] == ["read", "review"]
+    seed.child_http_calls = calls
+    return seed
+
+
+def apply(seed):
+    with Session(seed.flow.database.engine) as session, session.begin():
+        return apply_scope_recovery(session, seed.flow.worker.contracts, seed.child, owner_lease_token=seed.token)
+
+
+def entity_counts(flow):
+    with Session(flow.database.engine) as session:
+        return (session.scalar(select(func.count()).select_from(Entity)),
+                session.scalar(select(func.count()).select_from(EntitySnapshot)),
+                session.scalar(select(func.count()).select_from(LearningEvidence)))
+
+
+def test_actual_guard_to_mock_receipts_to_apply_refresh_and_idempotent_replay(flow):
+    seed = seed_scope(flow); case = seed.cases[0]
+    with Session(flow.database.engine) as session:
+        question = session.get(Entity, case["question_id"])
+        before_q, before_a = deepcopy(question.document), deepcopy(session.get(Entity, case["current_attempt_id"]).document)
+        before_annotations = deepcopy(session.get(Entity, case["current_attempt_id"]).annotations)
+        assert before_q["recognition_uncertainties"] == [answer_scope.SUMMARY]
+    dispatch_both(start(seed)); result = apply(seed)
+    assert result["applied_count"] == 1
+    assert seed.parent_http_calls == 2 and len(seed.child_http_calls) == 2  # four, not two, total Mock HTTP calls
+    with Session(flow.database.engine) as session:
+        question = session.get(Entity, case["question_id"])
+        attempt = session.get(Entity, case["current_attempt_id"])
+        current = session.get(Entity, case["id"])
+        decision = session.get(Entity, current.document["current_decision"]["id"])
+        assert question.revision == before_q["revision"] + 1
+        assert question.document == {**before_q, "revision": question.revision, "recognition_uncertainties": []}
+        assert attempt.id == before_a["id"] and attempt.document["recognition_revision"] == before_a["recognition_revision"] + 1
+        assert attempt.document["answer_text"] == "-\n-4" and attempt.document["recognition_status"] == "ready"
+        for key in ("asset_ids", "occurred_at", "created_at", "help_condition", "parent_attempt_id", "root_attempt_id"):
+            assert attempt.document[key] == before_a[key]
+        assert attempt.annotations["answer_slots"] == before_annotations["answer_slots"]
+        assert decision.document["origin"] == "model" and decision.document["validity"] == "candidate"
+        assert decision.document["verification"] == {"mode": "single", "status": "reviewed", "independent_readback": True, "reason_codes": []}
+        assert [check["student_answer"] for check in decision.document["answer_checks"]] == ["-", "-4"]
+        assert decision.document["knowledge_points"] == []
+        assert session.get(Entity, case["current_decision"]["id"]).document["validity"] == "stale"
+        assert session.get(Task, seed.child).status == "succeeded"
+    count = entity_counts(flow)
+    assert apply(seed) == result and entity_counts(flow) == count
+    for _ in range(2):
+        refreshed = flow.client.get("/v1/cases/" + case["id"]).json()
+        assert refreshed["current_attempt_id"] == case["current_attempt_id"]
+        assert refreshed["current_decision"]["answer_checks"][1]["student_answer"] == "-4"
+    assert len(seed.child_http_calls) == 2
+
+
+def test_one_stale_target_does_not_write_it_or_drop_valid_neighbor(flow):
+    seed = dispatch_both(start(seed_scope(flow, count=2)))
+    with Session(flow.database.engine) as session, session.begin():
+        attempt = session.get(Entity, seed.cases[0]["current_attempt_id"])
+        save_entity(session, flow.worker.contracts, flow.homework_id, "attempt",
+                    {**attempt.document, "revision": attempt.revision + 1}, row=attempt)
+        stale_document = deepcopy(attempt.document)
+    result = apply(seed)
+    assert result["applied_count"] == 1
+    assert result["target_outcomes"]["target_0"]["status"] == "stale_input"
+    with Session(flow.database.engine) as session:
+        assert session.get(Entity, seed.cases[0]["current_attempt_id"]).document == stale_document
+        assert session.get(Entity, seed.cases[1]["current_attempt_id"]).document["answer_text"] == "-\n-4"
+
+
+def test_bad_position_review_is_pending_without_new_decision_or_weakness(flow):
+    seed = start(seed_scope(flow))
+    dispatch_both(seed, lambda stage, data: data["targets"][0]["positions"].pop() if stage == "review" else None)
+    before = entity_counts(flow)
+    result = apply(seed)
+    assert result["applied_count"] == 0
+    assert result["target_outcomes"]["target_0"]["status"] == "ai_pending"
+    assert entity_counts(flow) == before
+
+
+@pytest.mark.parametrize("tamper", ["wire", "response", "receipt", "owner", "stopped", "lease"])
+def test_saved_protocol_or_host_context_tamper_cannot_apply(flow, tamper):
+    seed = dispatch_both(start(seed_scope(flow)))
+    before = entity_counts(flow)
+    with Session(flow.database.engine) as session, session.begin():
+        task = session.get(Task, seed.child); audit = deepcopy(task.audit)
+        if tamper == "wire": audit["scope_stages"]["read"].pop("wire")
+        elif tamper == "response": audit["scope_stages"]["review"]["response_trace"]["canonical_final_sha256"] = "0" * 64
+        elif tamper == "receipt": audit["scope_stages"]["review"]["validation_receipt"]["owner_lease_digest"] = "0" * 64
+        elif tamper == "owner": task.lease_token = "lease_not_owner"
+        elif tamper == "stopped": session.get(Homework, flow.homework_id).processing_blocked = True
+        else: task.lease_expires_at = now() - timedelta(seconds=1)
+        task.audit = audit
+    with pytest.raises(Rejected): apply(seed)
+    assert entity_counts(flow) == before
