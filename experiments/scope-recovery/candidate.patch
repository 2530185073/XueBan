@@ -0,0 +1,626 @@
+"""Private SQLAlchemy recovery ledger; no network or production worker registration.
+
+Only host-owned parent audit is an admission source. No caller-supplied manifest
+or host_generated flag is accepted. A future producer must write this namespace
+outside model output. This candidate does not manufacture proof for old jobs.
+"""
+from copy import deepcopy
+from dataclasses import asdict, is_dataclass
+from datetime import datetime, timedelta, timezone
+import hashlib
+import json
+import re
+
+from sqlalchemy import select, update
+from sqlalchemy.exc import OperationalError
+from sqlalchemy.orm import Session
+
+from xueban_backend.correction_core import event, fingerprint, input_versions, iso, new_id, now
+from xueban_backend.correction_models import Asset, Entity, Task
+from xueban_backend.models import Homework, Student
+from xueban_backend.student_locks import lock_task_student, task_scope_current
+from xueban_backend.providers.reconciliation import source_id
+from xueban_backend.providers.whole_page import canonical_label
+from xueban_backend.providers.whole_page import normalize_page_stem
+from xueban_backend.providers.answer_scope import scope_gap
+from xueban_backend.recognition_recheck import target_document, active_job as active_r1_job
+
+KIND = 'scope_recovery'
+PROTOCOL = 'page-scope-durable.candidate.v1'
+ROUTE_PROTOCOL = 'page-scope-route.host.v1'
+HOST_KEY = 'scope_recovery_host_pages'
+STAGES = ('read', 'review')
+SHA = re.compile(r'[0-9a-f]{64}')
+REVIEW_STAGES = {'reconciliation', 'visual_reconciliation', 'visual_adjudication', 'scope_review'}
+KNOWN_STAGES = REVIEW_STAGES | {'primary', 'secondary', 'readback', 'semantic_alignment', 'visual', 'critical_visual'}
+POLICY = {'protocol':'scope-budget.candidate.v1', 'max_review_calls':2, 'max_scope_reads':1, 'max_scope_reviews':1}
+
+
+class Rejected(ValueError):
+    """Fixed host code only; never include raw provider or DB exception text."""
+
+
+def _digest_token(token):
+    return hashlib.sha256(token.encode()).hexdigest()
+
+
+def _dt(value):
+    if isinstance(value, str):
+        value = datetime.fromisoformat(value.replace('Z', '+00:00'))
+    return value.replace(tzinfo=value.tzinfo or timezone.utc)
+
+
+def _json(value):
+    if is_dataclass(value):
+        value = asdict(value)
+    result = deepcopy(value)
+    json.dumps(result, allow_nan=False)  # Reject rather than coerce source data.
+    return result
+
+
+def _contract():
+    from .providers import scope_recovery_contract
+    return scope_recovery_contract
+
+
+def active_for_case(session, case):
+    """Caller holds the student/homework mutation scope; no second task lock."""
+    jobs = session.scalars(select(Task).where(Task.homework_id == case.homework_id,
+        Task.kind == KIND, Task.status.in_(['queued','running','retryable_failed'])))
+    return next((job for job in jobs if any(target.get('case_id') == case.id
+        and target.get('attempt_id') == case.document.get('current_attempt_id')
+        for target in job.inputs.get('targets', []))), None)
+
+
+def _task_change(session, row, *, audit=None, status=None, lease_token=None,
+                 lease_expires_at=None, tries=None, set_lease=False):
+    revision = row.revision + 1
+    document = {**row.document, 'revision': revision, 'updated_at': iso()}
+    values = {'revision': revision, 'document': document}
+    if audit is not None:
+        values['audit'] = _json(audit)
+    if status is not None:
+        values['status'] = document['status'] = status
+        document['retry_after_seconds'] = 2 if status in ('queued', 'running') else None
+        document['result'] = ({'resource_type':'homework','resource_id':row.homework_id} if status == 'succeeded' else None)
+        document['failure'] = ({'code':'worker_failure',
+            'message':('范围核对材料已保存，尚未接入结果应用；原作答继续待完成。'
+                if (audit or {}).get('outcome') == 'protocol_complete_pending_application'
+                else '本次范围核对未完成；已预约请求不会自动重复发送。'),
+            'retryable':False} if status == 'failed' else None)
+    if set_lease:
+        values.update(lease_token=lease_token, lease_expires_at=lease_expires_at)
+    if tries is not None:
+        values['tries'] = tries
+    try:
+        changed = session.execute(update(Task).where(Task.id == row.id, Task.revision == row.revision)
+                                  .values(**values).execution_options(synchronize_session=False))
+    except OperationalError:
+        raise Rejected('concurrent_change') from None
+    if changed.rowcount != 1:
+        raise Rejected('concurrent_change')
+    event(session, row.homework_id, row.id, revision, 'scope.' + (status or 'checkpoint'))
+    session.refresh(row)
+
+
+class DurableScope:
+    def __init__(self, engine, *, clock=now, asset_reader=None):
+        self.engine, self.clock, self.asset_reader = engine, clock, asset_reader
+
+    def _parent_context(self, session, parent_id, *, permit_blocked=False):
+        scope = lock_task_student(session, parent_id)
+        parent = session.scalar(select(Task).where(Task.id == parent_id).with_for_update()
+                                .execution_options(populate_existing=True))
+        if parent is None:
+            raise Rejected('parent_not_found')
+        homework = session.scalar(select(Homework).where(Homework.id == parent.homework_id).with_for_update()
+                                  .execution_options(populate_existing=True))
+        if not task_scope_current(scope, homework) or (not permit_blocked and (not scope['student'].active or homework.processing_blocked)):
+            raise Rejected('processing_blocked')
+        return parent, homework
+
+    def _child_context(self, session, child_id, *, permit_blocked=False, validate_snapshot=True):
+        child = session.get(Task, child_id)
+        if child is None or child.kind != KIND:
+            raise Rejected('task_not_found')
+        parent, homework = self._parent_context(session, child.inputs['parent_job_id'], permit_blocked=permit_blocked)
+        child = session.scalar(select(Task).where(Task.id == child_id).with_for_update()
+                               .execution_options(populate_existing=True))
+        if child.homework_id != homework.id:
+            raise Rejected('parent_binding_changed')
+        if validate_snapshot and not self._snapshot_current(parent,child):
+            raise Rejected('route_or_snapshot_changed')
+        return parent, homework, child
+
+    def _snapshot_current(self, parent, child):
+        if (parent.audit or {}).get('scope_recovery_pages', {}).get(child.inputs['asset_id']) != child.id:
+            return False
+        route = deepcopy((parent.audit or {}).get(HOST_KEY, {}).get(child.inputs['asset_id'], {}).get('route_manifest'))
+        if not isinstance(route,dict) or route.get('review_budget',{}).get('scope_reserved_for_child') != child.id:
+            return False
+        route['review_budget']['scope_reserved_for_child'] = None
+        frozen = {k:v for k,v in child.inputs.items() if k != 'recovery_input_sha256'}
+        return (parent.status == 'succeeded' and parent.tries == 1
+                and fingerprint((parent.audit or {}).get('executions')) == child.inputs.get('parent_execution_sha256')
+                and fingerprint(route) == child.inputs.get('parent_route_manifest_sha256')
+                and fingerprint(frozen) == child.inputs.get('recovery_input_sha256'))
+
+    def _asset(self, session, homework, asset_id):
+        asset = session.get(Asset, asset_id)
+        if asset is None or asset.homework_id != homework.id or asset.document.get('status') != 'uploaded':
+            raise Rejected('asset_unavailable')
+        return asset
+
+    def _freeze_target(self, session, homework, asset, target):
+        if not isinstance(target, dict) or not isinstance(target.get('target_key'), str):
+            raise Rejected('invalid_host_target')
+        case = session.get(Entity, target.get('case_id'))
+        if case is None or case.kind != 'case' or case.homework_id != homework.id or case.document.get('lifecycle') != 'active':
+            raise Rejected('target_unavailable')
+        if active_r1_job(session,case):
+            raise Rejected('original_recheck_active')
+        question = session.get(Entity, case.document['question_id'])
+        attempt = session.get(Entity, case.document['current_attempt_id'])
+        if (question is None or attempt is None or question.kind != 'question' or attempt.kind != 'attempt'
+                or question.homework_id != homework.id or attempt.homework_id != homework.id
+                or attempt.document.get('case_id') != case.id or attempt.document.get('asset_ids') != [asset.id]
+                or {r['asset_id'] for r in question.document.get('regions', [])} != {asset.id}):
+            raise Rejected('target_binding_invalid')
+        decision = case.document.get('current_decision') or {}
+        decision_row = session.get(Entity, decision.get('id')) if decision.get('id') else None
+        if (decision_row is None or decision_row.kind != 'decision' or decision_row.homework_id != homework.id
+                or decision_row.revision != decision.get('revision') or decision_row.document != decision):
+            raise Rejected('decision_binding_invalid')
+        if decision.get('origin') == 'staff' and decision.get('validity') == 'confirmed':
+            raise Rejected('staff_confirmed')
+        sources = target.get('baseline_sources')
+        ids = target.get('baseline_source_ids')
+        if (not isinstance(sources, list) or len(sources) != 2 or not all(isinstance(v, dict) for v in sources)
+                or ids != [source_id(role, raw) for role, raw in zip(('primary', 'secondary'), sources)]):
+            raise Rejected('source_binding_invalid')
+        label = canonical_label(sources[0].get('label') or '')
+        if not label or canonical_label(sources[1].get('label') or '') != label:
+            raise Rejected('source_target_mismatch')
+        printed = target_document(question)
+        stored = {**printed, 'answer_text': attempt.document.get('answer_text'),
+                  'answer_status': (attempt.annotations or {}).get('answer_status', attempt.document.get('answer_status'))}
+        if (canonical_label(printed.get('label') or '') != label
+                or any(normalize_page_stem(s) != normalize_page_stem(printed)
+                       or s.get('options', []) != printed.get('options', []) for s in sources)
+                or not scope_gap(stored) or attempt.document.get('recognition_status') != 'needs_revision'):
+            raise Rejected('not_pending_scope_target')
+        return {'target_key': target['target_key'], 'case_id': case.id, 'question_id': question.id,
+                'question_revision': question.revision, 'attempt_id': attempt.id,
+                'attempt_revision': attempt.revision,
+                'attempt_recognition_revision': attempt.document['recognition_revision'],
+                'current_decision': {'id': decision.get('id'), 'revision': decision.get('revision')},
+                'input_versions': input_versions(case, question, attempt, [asset]),
+                'baseline_sources': _json(sources), 'baseline_source_ids': list(ids), 'canonical_label': label,
+                'locator': deepcopy(printed.get('visible_locator') or target.get('locator'))}
+
+    def _manifest(self, parent, asset):
+        if parent.kind != 'recognize_homework' or parent.status != 'succeeded':
+            raise Rejected('parent_not_completed')
+        executions = (parent.audit or {}).get('executions')
+        # Initial candidate refuses retry/unknown histories instead of inferring
+        # a fee budget from only the final successful response.
+        if parent.tries != 1 or not isinstance(executions, list) or len(executions) != 1 or executions[0].get('outcome') != 'succeeded':
+            raise Rejected('dispatch_history_unproven')
+        page = (parent.audit or {}).get(HOST_KEY, {}).get(asset.id)
+        if not isinstance(page, dict):
+            raise Rejected('host_route_manifest_missing')
+        route = page.get('route_manifest')
+        if (not isinstance(route, dict) or route.get('protocol') != ROUTE_PROTOCOL
+                or route.get('asset_id') != asset.id or route.get('image_sha256') != asset.document['sha256']
+                or route.get('parent_execution_number') != 1 or route.get('policy') != POLICY):
+            raise Rejected('host_route_manifest_invalid')
+        dispatches = route.get('legacy_dispatches')
+        credit = route.get('review_budget')
+        if (not isinstance(dispatches, list) or not all(isinstance(v, dict) and v.get('receipt_ref')
+                and v.get('stage') in KNOWN_STAGES and isinstance(v.get('requested_target_keys'), list)
+                and v.get('outcome') in ('returned','failed','unknown','reserved') for v in dispatches)
+                or len({d['receipt_ref'] for d in dispatches}) != len(dispatches)
+                or not isinstance(credit, dict) or credit.get('scope_reserved_for_child') is not None
+                or credit.get('limit') != 2):
+            raise Rejected('review_credit_unproven')
+        reviews = [d for d in dispatches if d.get('stage') in REVIEW_STAGES]
+        receipts = credit.get('receipts')
+        if (not isinstance(receipts, list) or any(not isinstance(v, dict) for v in receipts)
+                or [r.get('receipt_id') for r in receipts] != [d['receipt_ref'] for d in reviews]
+                or any(r.get('stage') not in REVIEW_STAGES
+                       or r.get('state') not in ('reserved','returned','unknown','failed') for r in receipts)
+                or any(r.get('stage') != d['stage'] or r.get('state') != d['outcome']
+                       or r.get('requested_target_keys') != d['requested_target_keys'] for r,d in zip(receipts,reviews))):
+            raise Rejected('review_credit_unproven')
+        if len(reviews) >= 2:
+            raise Rejected('review_budget_exhausted')
+        targets = page.get('targets')
+        owned = route.get('scope_owned')
+        if not isinstance(targets, list) or not 1 <= len(targets) <= 6 or not isinstance(owned, list):
+            raise Rejected('invalid_host_targets')
+        keys = [t.get('target_key') for t in targets if isinstance(t, dict)]
+        if len(keys) != len(targets) or len(set(keys)) != len(keys):
+            raise Rejected('invalid_host_targets')
+        if any(set(d['requested_target_keys']) & set(keys) for d in dispatches if d['stage'] not in ('primary','secondary')):
+            raise Rejected('target_already_dispatched')
+        return page, route
+
+    def create_for_completed_page(self, parent_task_id, asset_id):
+        with Session(self.engine, expire_on_commit=False) as session:
+            parent, homework = self._parent_context(session, parent_task_id)
+            existing = (parent.audit or {}).get('scope_recovery_pages', {}).get(asset_id)
+            if existing:
+                child = session.get(Task, existing)
+                if child is None or child.kind != KIND or child.inputs.get('parent_job_id') != parent.id or child.inputs.get('asset_id') != asset_id:
+                    raise Rejected('parent_binding_changed')
+                return {'task_id': existing, 'created': False}
+            asset = self._asset(session, homework, asset_id)
+            page, route = self._manifest(parent, asset)
+            targets = [self._freeze_target(session, homework, asset, t) for t in page['targets']]
+            expected_owned = [{'target_key': t['target_key'], 'canonical_label': t['canonical_label'], 'source_ids': t['baseline_source_ids']} for t in targets]
+            if route['scope_owned'] != expected_owned:
+                raise Rejected('scope_ownership_mismatch')
+            stamp = self.clock(); identifier = new_id('job')
+            if self.asset_reader is None:
+                raise Rejected('asset_reader_required')
+            image_bytes = self.asset_reader(asset.id, deepcopy(asset.document))
+            if not isinstance(image_bytes, bytes) or hashlib.sha256(image_bytes).hexdigest() != asset.document['sha256']:
+                raise Rejected('image_integrity_mismatch')
+            typed_targets = [{k:deepcopy(v) for k,v in t.items() if k not in ('baseline_source_ids','canonical_label')} for t in targets]
+            for row,t in zip(typed_targets, targets):
+                row['baseline_sources'] = [{'role':role,'source_id':sid,'observation':deepcopy(raw)}
+                    for role,sid,raw in zip(('primary','secondary'),t['baseline_source_ids'],t['baseline_sources'])]
+            snapshot = _contract().freeze_snapshot(parent_job_id=parent.id,recovery_job_id=identifier,
+                asset_id=asset.id,image_bytes=image_bytes,targets=typed_targets)
+            inputs = {'protocol': PROTOCOL, 'parent_job_id': parent.id, 'asset_id': asset.id,
+                      'image_sha256': asset.document['sha256'], 'parent_route_manifest_sha256': fingerprint(route),
+                      'parent_execution_sha256':fingerprint(parent.audit['executions']),
+                      'targets': targets, 'deadline_at': iso(stamp + timedelta(minutes=10)),
+                      'policy': deepcopy(POLICY),
+                      'stage_limits': {'read': 1, 'review': 1, 'read_max_tokens': 12288, 'review_max_tokens': 16384}}
+            inputs['typed_snapshot'] = {'frozen_json':snapshot.frozen_json,'sha256':snapshot.sha256}
+            inputs['input_snapshot_sha256'] = snapshot.sha256
+            inputs['recovery_input_sha256'] = fingerprint(inputs)
+            audit = {'executions': [], 'scope_stages': {name: {'status': 'available'} for name in STAGES}, 'target_outcomes': {}}
+            doc = {'id': identifier, 'revision': 1, 'kind': KIND, 'status': 'queued', 'created_at': iso(stamp),
+                   'updated_at': iso(stamp), 'retry_after_seconds': 1, 'failure': None, 'result': None}
+            child = Task(id=identifier, homework_id=homework.id, revision=1, kind=KIND, status='queued',
+                         document=doc, inputs=_json(inputs), audit=audit, tries=0, available_at=stamp)
+            parent_audit = deepcopy(parent.audit)
+            parent_audit.setdefault('scope_recovery_pages', {})[asset_id] = identifier
+            parent_audit.setdefault('scope_review_allocations', {})[asset_id] = {'owner_task_id': identifier, 'status': 'allocated', 'limit': 1}
+            parent_audit[HOST_KEY][asset_id]['route_manifest']['review_budget']['scope_reserved_for_child'] = identifier
+            _task_change(session, parent, audit=parent_audit)
+            session.add(child)
+            event(session, homework.id, identifier, 1, 'job.queued', {'protocol': PROTOCOL})
+            session.commit()
+            return {'task_id': identifier, 'created': True}
+
+    def _current_targets(self, session, homework, task):
+        try:
+            asset = self._asset(session, homework, task.inputs['asset_id'])
+        except Rejected:
+            return {}, {t['target_key']: 'asset_unavailable' for t in task.inputs['targets']}
+        if asset.document['sha256'] != task.inputs['image_sha256']:
+            return {}, {t['target_key']: 'image_changed' for t in task.inputs['targets']}
+        current, rejected = {}, {}
+        for frozen in task.inputs['targets']:
+            key = frozen['target_key']
+            try:
+                live = self._freeze_target(session, homework, asset, frozen)
+            except Rejected as error:
+                rejected[key] = str(error); continue
+            fields = ('case_id','question_id','question_revision','attempt_id','attempt_revision','attempt_recognition_revision','current_decision')
+            if any(live[field] != frozen[field] for field in fields) or live['input_versions']['fingerprint'] != frozen['input_versions']['fingerprint']:
+                rejected[key] = 'stale_input'
+            else:
+                current[key] = frozen
+        return current, rejected
+
+    def _live(self, task, token):
+        return (task.status == 'running' and task.lease_token == token and task.lease_expires_at is not None
+                and _dt(task.lease_expires_at) > self.clock() and _dt(task.inputs['deadline_at']) > self.clock())
+
+    def _typed_request(self, task, stage):
+        contract = _contract()
+        snapshot = contract.FrozenDocument(**task.inputs['typed_snapshot'])
+        if stage == 'read':
+            return snapshot, contract.blind_read_request(snapshot)
+        read = task.audit['scope_stages']['read']
+        if read['status'] != 'returned' or 'raw_final' not in read:
+            raise Rejected('read_not_completed')
+        if not self._returned_transport_current(task,'read',contract.blind_read_request(snapshot)):
+            raise Rejected('read_transport_unproven')
+        try:
+            batch = contract.validate_readback(snapshot, contract.blind_read_request(snapshot), read['validation_receipt'], read['raw_final'])
+            request = contract.scope_review_request(snapshot, batch)
+        except contract.ContractError:
+            raise Rejected('read_not_reviewable') from None
+        return snapshot, request
+
+    def prepare_stage(self, task_id, stage):
+        """Pure preparation; grants no send permission or fee reservation."""
+        if stage not in STAGES:
+            raise Rejected('invalid_stage')
+        with Session(self.engine) as session:
+            _,_,task = self._child_context(session,task_id)
+            _,request = self._typed_request(task,stage)
+            return {'request':request.payload(),'request_contract_sha256':request.sha256,
+                    'prompt_sha256':_contract().digest(request.payload()['prompt']),
+                    'schema_sha256':_contract().digest(request.payload()['schema']),
+                    'target_keys':[t['target_key'] for t in request.payload()['input']['targets']],
+                    'wire_expected':{'stage':'scope_'+stage,'role':'recognition' if stage=='read' else 'check',
+                        'input_sha256':_contract().digest(request.payload()['input']),
+                        'actual_image_sha256':task.inputs['image_sha256']}}
+
+    def claim(self, task_id, *, lease_seconds=120):
+        with Session(self.engine) as session:
+            _, homework, task = self._child_context(session, task_id)
+            if task.status not in ('queued', 'running'):
+                return None
+            if task.status == 'running' and task.lease_expires_at and _dt(task.lease_expires_at) > self.clock():
+                return None
+            audit = deepcopy(task.audit)
+            reserved = [v for v in audit['scope_stages'].values() if v['status'] == 'reserved']
+            if reserved or _dt(task.inputs['deadline_at']) <= self.clock():
+                for row in reserved:
+                    row['status'] = 'unknown'
+                audit['outcome'] = 'execution_unknown' if reserved else 'deadline_exceeded'
+                _task_change(session, task, audit=audit, status='failed', set_lease=True)
+                session.commit(); return None
+            current, stale = self._current_targets(session, homework, task)
+            audit['target_outcomes'].update(stale)
+            if not current:
+                audit['outcome'] = 'stale_input'
+                _task_change(session, task, audit=audit, status='superseded', set_lease=True)
+                session.commit(); return None
+            token = new_id('lease')
+            audit['executions'].append({'number': task.tries + 1, 'lease_digest': _digest_token(token), 'started_at': iso(self.clock())})
+            _task_change(session, task, audit=audit, status='running', tries=task.tries+1,
+                         set_lease=True, lease_token=token, lease_expires_at=self.clock()+timedelta(seconds=lease_seconds))
+            session.commit(); return token
+
+    def renew_lease(self, task_id, token, *, lease_seconds=120):
+        with Session(self.engine) as session:
+            _, _, task = self._child_context(session, task_id)
+            if not self._live(task, token):
+                return False
+            _task_change(session, task, set_lease=True, lease_token=token,
+                         lease_expires_at=min(self.clock()+timedelta(seconds=lease_seconds), _dt(task.inputs['deadline_at'])))
+            session.commit(); return True
+
+    def reserve_stage(self, task_id, token, stage, request):
+        if stage not in STAGES:
+            raise Rejected('invalid_stage')
+        with Session(self.engine) as session:
+            parent, homework, task = self._child_context(session, task_id)
+            if not self._live(task, token):
+                raise Rejected('lease_not_current')
+            audit = deepcopy(task.audit); slot = audit['scope_stages'][stage]
+            if slot['status'] != 'available':
+                raise Rejected('stage_already_reserved')
+            current, stale = self._current_targets(session, homework, task)
+            snapshot, typed_request = self._typed_request(task, stage)
+            typed_body = typed_request.payload()
+            read = audit['scope_stages']['read']
+            expected_keys = [t['target_key'] for t in typed_body['input']['targets']]
+            keys = request.get('target_keys')
+            if not keys or keys != expected_keys or not set(keys) <= set(current):
+                raise Rejected('target_snapshot_changed')
+            if request.get('actual_image_sha256') != task.inputs['image_sha256']:
+                raise Rejected('wire_image_mismatch')
+            for key in ('request_payload_sha256','request_contract_sha256','schema_sha256','prompt_sha256'):
+                if not isinstance(request.get(key), str) or not SHA.fullmatch(request[key]):
+                    raise Rejected('request_hash_invalid')
+            if (request['request_contract_sha256'] != typed_request.sha256
+                    or request['schema_sha256'] != _contract().digest(typed_body['schema'])
+                    or request['prompt_sha256'] != _contract().digest(typed_body['prompt'])):
+                raise Rejected('request_contract_changed')
+            if not isinstance(request.get('model'), str) or not request['model'] or type(request.get('max_output_tokens')) is not int or not 1 <= request['max_output_tokens'] <= task.inputs['stage_limits'][stage+'_max_tokens']:
+                raise Rejected('request_budget_invalid')
+            receipt = {k: deepcopy(request[k]) for k in ('request_payload_sha256','request_contract_sha256','schema_sha256','prompt_sha256','model','max_output_tokens','target_keys')}
+            receipt.pop('max_output_tokens')
+            receipt.update(receipt_id=new_id('receipt'), stage='scope_'+stage, actual_image_sha256=task.inputs['image_sha256'],
+                           parent_job_id=task.inputs['parent_job_id'],recovery_job_id=task.id,asset_id=task.inputs['asset_id'],
+                           input_snapshot_sha256=task.inputs['input_snapshot_sha256'], owner_lease_digest=_digest_token(token),transport_complete=False)
+            if stage == 'review':
+                expected_sources = [t['source_id'] for t in typed_body['input']['targets']]
+                if request.get('read_receipt_id') != read['receipt']['receipt_id'] or request.get('observation_source_ids') != expected_sources:
+                    raise Rejected('read_source_binding_invalid')
+                receipt.update(read_receipt_id=request['read_receipt_id'], observation_source_ids=deepcopy(request['observation_source_ids']))
+                allocation = (parent.audit or {}).get('scope_review_allocations', {}).get(task.inputs['asset_id'])
+                if not allocation or allocation.get('owner_task_id') != task.id or allocation.get('status') != 'allocated':
+                    raise Rejected('review_credit_consumed')
+                parent_audit = deepcopy(parent.audit)
+                parent_audit['scope_review_allocations'][task.inputs['asset_id']].update(status='reserved', receipt_id=receipt['receipt_id'])
+                _task_change(session, parent, audit=parent_audit)
+            audit['target_outcomes'].update(stale)
+            audit['scope_stages'][stage] = {'status':'reserved', 'receipt':receipt, 'request':typed_body,
+                'started_at':iso(self.clock()), 'max_output_tokens':request['max_output_tokens'],'charge_status':'unknown'}
+            _task_change(session, task, audit=audit)
+            session.commit()
+            # Only this successful new reservation yields a send permit. A
+            # repeated identical request raises; it never returns this permit.
+            return {'permit_send': True, 'receipt': receipt}
+
+    def _wire_expected(self, task, stage, request):
+        slot=task.audit['scope_stages'][stage]; receipt=slot['receipt']
+        return {'protocol':'scope-wire.mock.v1','transport_kind':'httpx_mock',
+            'request_body_sha256':receipt['request_payload_sha256'],
+            'request_contract_sha256':request.sha256,'input_sha256':_contract().digest(request.payload()['input']),
+            'prompt_sha256':receipt['prompt_sha256'],'schema_sha256':receipt['schema_sha256'],
+            'actual_image_sha256':task.inputs['image_sha256'],'model':receipt['model'],
+            'max_output_tokens':slot['max_output_tokens'],'stage':'scope_'+stage,
+            'role':'recognition' if stage=='read' else 'check','receipt_id':receipt['receipt_id']}
+
+    def _wire_current(self, task, stage, request):
+        slot=task.audit['scope_stages'][stage]
+        return (slot.get('request') == request.payload()
+            and slot.get('wire') == self._wire_expected(task,stage,request))
+
+    @staticmethod
+    def _response_current(slot):
+        trace=slot.get('response_trace');raw=slot.get('raw_final');metadata=slot.get('metadata')
+        if not isinstance(raw,str) or not isinstance(trace,dict):return False
+        expected={'protocol':'scope-response.mock.v1','transport_kind':'httpx_mock',
+            'receipt_id':slot['receipt']['receipt_id'],
+            'request_body_sha256':slot['receipt']['request_payload_sha256'],
+            'response_body_sha256':trace.get('response_body_sha256'),
+            'canonical_final_sha256':hashlib.sha256(raw.encode()).hexdigest(),
+            'metadata_sha256':fingerprint(metadata),'transport_complete':True}
+        return (set(trace)==set(expected) and trace==expected
+            and isinstance(trace['response_body_sha256'],str) and bool(SHA.fullmatch(trace['response_body_sha256'])))
+
+    @staticmethod
+    def _transport_success(metadata, complete, raw, receipt):
+        attempts=metadata.get('attempts') or []
+        return (complete is True and isinstance(raw,str) and len(attempts)==1
+            and attempts[0].get('number')==1 and attempts[0].get('status_code')==200
+            and attempts[0].get('code')=='ok' and metadata.get('requested_model')==receipt['model'])
+
+    def _returned_transport_current(self,task,stage,request):
+        slot=task.audit['scope_stages'][stage];receipt=slot.get('receipt',{})
+        body=request.payload();keys=[row['target_key'] for row in body['input']['targets']]
+        expected={'stage':'scope_'+stage,'parent_job_id':task.inputs['parent_job_id'],'recovery_job_id':task.id,
+            'asset_id':task.inputs['asset_id'],'input_snapshot_sha256':task.inputs['input_snapshot_sha256'],
+            'request_contract_sha256':request.sha256,'prompt_sha256':_contract().digest(body['prompt']),
+            'schema_sha256':_contract().digest(body['schema']),'actual_image_sha256':task.inputs['image_sha256'],
+            'target_keys':keys,'transport_complete':False}
+        return (all(receipt.get(k)==v for k,v in expected.items())
+            and receipt.get('owner_lease_digest') in [row.get('lease_digest') for row in task.audit.get('executions',[])]
+            and slot.get('validation_receipt')=={**receipt,'transport_complete':True}
+            and self._transport_success(slot.get('metadata',{}),True,slot.get('raw_final'),receipt)
+            and self._wire_current(task,stage,request) and self._response_current(slot))
+
+    def record_wire(self, task_id, token, stage, receipt_id, evidence):
+        """Called only inside the audited MockTransport request collector."""
+        if stage not in STAGES:raise Rejected('invalid_stage')
+        with Session(self.engine) as session:
+            _,homework,task=self._child_context(session,task_id)
+            slot=task.audit['scope_stages'][stage]
+            if not self._live(task,token) or slot['status']!='reserved':raise Rejected('wire_lease_not_current')
+            if slot['receipt']['receipt_id']!=receipt_id or slot['receipt']['owner_lease_digest']!=_digest_token(token):
+                raise Rejected('receipt_owner_mismatch')
+            if 'wire' in slot:raise Rejected('wire_already_recorded')
+            _,request=self._typed_request(task,stage)
+            if _json(evidence)!=self._wire_expected(task,stage,request):raise Rejected('wire_binding_mismatch')
+            current,_=self._current_targets(session,homework,task)
+            if not set(slot['receipt']['target_keys'])<=set(current):raise Rejected('target_snapshot_changed')
+            audit=deepcopy(task.audit);audit['scope_stages'][stage]['wire']=_json(evidence)
+            _task_change(session,task,audit=audit);session.commit()
+            return {'recorded':True}
+
+    def locked_apply_context(self, session, task_id, owner_lease_token):
+        parent,homework,task=self._child_context(session,task_id)
+        if task.status=='succeeded' and (task.audit or {}).get('scope_application'):
+            executions=task.audit.get('executions') or []
+            if not executions or executions[-1].get('lease_digest')!=_digest_token(owner_lease_token):
+                raise Rejected('lease_not_current')
+            return parent,homework,task
+        if not self._live(task,owner_lease_token):raise Rejected('lease_not_current')
+        return parent,homework,task
+
+    def validated_protocol(self, task):
+        contract=_contract();snapshot,request=self._typed_request(task,'review')
+        read=task.audit['scope_stages']['read'];review=task.audit['scope_stages']['review']
+        if review.get('status')!='returned' or not self._returned_transport_current(task,'review',request):
+            raise Rejected('review_transport_unproven')
+        try:
+            batch=contract.validate_readback(snapshot,contract.blind_read_request(snapshot),read['validation_receipt'],read['raw_final'])
+            result=contract.validate_scope_review(snapshot,batch,request,review['validation_receipt'],review['raw_final'])
+        except contract.ContractError:raise Rejected('saved_protocol_invalid') from None
+        return snapshot,batch,result
+
+    def finish_applied(self, session, task, *, audit_updates):
+        """Dedicated apply transaction owns entity CAS; this only closes its job."""
+        if task.status!='running' or not task.lease_token or not self._live(task,task.lease_token):
+            raise Rejected('lease_not_current')
+        if not isinstance(audit_updates,dict) or not audit_updates.get('scope_application') or set(audit_updates)-{'scope_application','target_outcomes'}:
+            raise Rejected('invalid_application_audit')
+        self.validated_protocol(task)
+        audit=deepcopy(task.audit);audit.update(_json(audit_updates))
+        audit['outcome']='applied' if audit_updates['scope_application'].get('applied_count',0)>0 else 'unchanged_pending'
+        _task_change(session,task,audit=audit,status='succeeded',set_lease=True)
+
+    def record_return(self, task_id, token, stage, receipt_id, *, metadata, raw_final, transport_complete=False, response_evidence=None):
+        """Host adapter passes canonical final JSON, not envelope/reasoning.
+
+        Production prerequisite: canonicalize CandidateResult.data, scan data AND
+        Metadata/attempts against every configured provider credential before this
+        call. This DB candidate has no adapter and does not claim to prove it.
+
+        Raw final text goes through the pure typed validator again inside this
+        layer. No caller-supplied success/source-id flags can authorize review.
+        """
+        if stage not in STAGES:
+            raise Rejected('invalid_stage')
+        if (raw_final is not None and (not isinstance(raw_final,str) or len(raw_final.encode()) > 512_000)) or type(transport_complete) is not bool:
+            raise Rejected('invalid_final_text')
+        evidence = {'metadata': _json(metadata), 'raw_final': raw_final, 'transport_complete':transport_complete,
+                    'response_trace':_json(response_evidence)}
+        evidence_hash = fingerprint(evidence)
+        with Session(self.engine) as session:
+            parent, homework, task = self._child_context(session, task_id, permit_blocked=True,validate_snapshot=False)
+            audit = deepcopy(task.audit); slot = audit['scope_stages'][stage]
+            receipt = slot.get('receipt', {})
+            if receipt.get('receipt_id') != receipt_id or receipt.get('owner_lease_digest') != _digest_token(token):
+                raise Rejected('receipt_owner_mismatch')
+            if 'evidence_sha256' in slot:
+                if slot['evidence_sha256'] != evidence_hash:
+                    raise Rejected('conflicting_return')
+                return {'recorded': False, 'late': slot['status'] == 'unknown', 'eligible_for_release': False}
+            if slot['status'] not in ('reserved', 'unknown'):
+                raise Rejected('stage_not_reserved')
+            # Deletion/revocation must not recreate private observations on return.
+            stopped = homework.processing_blocked or not session.get(Student,homework.student_id).active
+            late = not self._live(task, token) or stopped or not self._snapshot_current(parent,task)
+            current, stale = ({}, {}) if late else self._current_targets(session, homework, task)
+            audit['target_outcomes'].update(stale)
+            success = self._transport_success(evidence['metadata'],transport_complete,raw_final,receipt)
+            validation_receipt = {**receipt,'transport_complete':bool(success)}
+            validated = None
+            if not late:
+                contract = _contract()
+                try:
+                    snapshot, typed_request = self._typed_request(task,stage)
+                    if not self._wire_current(task,stage,typed_request) or not self._response_current({**slot,**evidence}):
+                        raise Rejected('transport_unproven')
+                    if stage == 'read':
+                        validated = contract.validate_readback(snapshot,typed_request,validation_receipt,raw_final).payload()
+                    else:
+                        read = audit['scope_stages']['read']
+                        batch = contract.validate_readback(snapshot,contract.blind_read_request(snapshot),read['validation_receipt'],read['raw_final'])
+                        validated = contract.validate_scope_review(snapshot,batch,typed_request,validation_receipt,raw_final).payload()
+                except (contract.ContractError, Rejected):
+                    slot['validation_error'] = 'typed_contract_failed'
+            slot.update(status='unknown' if late else 'returned', evidence_sha256=evidence_hash,
+                        returned_at=iso(self.clock()), metadata=(self._minimal_usage(evidence['metadata']) if stopped else evidence['metadata']),
+                        **({'late_return':{'reason':'processing_stopped' if stopped else 'lease_or_snapshot_not_current'}} if late else {'raw_final':raw_final if success and validated is not None else None, 'validation_receipt':validation_receipt,
+                           'typed_validation':validated,'response_trace':evidence['response_trace']}))
+            slot['eligible_target_keys'] = [] if late else [k for k in receipt['target_keys'] if k in current]
+            status = 'failed' if late or validated is None else 'running'
+            if late:
+                audit['outcome'] = 'processing_stopped' if stopped else 'execution_unknown'
+            elif validated is None:
+                audit['outcome'] = 'service_or_contract_failed'
+            elif stage == 'review':
+                audit['outcome'] = 'protocol_complete_pending_application'
+            _task_change(session, task, audit=audit, status=status, set_lease=status != 'running',
+                         lease_token=None, lease_expires_at=None)
+            session.commit()
+            return {'recorded': True, 'late': late, 'eligible_for_release': False}
+
+    @staticmethod
+    def _minimal_usage(metadata):
+        # No final text, model/request IDs, or arbitrary diagnostics after stop.
+        return {'usage':deepcopy(metadata.get('usage')), 'latency_ms':metadata.get('latency_ms'),
+                'attempts':[{key:deepcopy(row.get(key)) for key in ('number','status_code','latency_ms','usage','charge_status')}
+                            for row in metadata.get('attempts',[])]}
+
+    def inspect(self, task_id):
+        with Session(self.engine) as session:
+            row = session.get(Task, task_id)
+            if row is None or row.kind != KIND:
+                raise Rejected('task_not_found')
+            return {'id':row.id, 'status':row.status, 'revision':row.revision,
+                    'inputs':deepcopy(row.inputs), 'audit':deepcopy(row.audit)}
