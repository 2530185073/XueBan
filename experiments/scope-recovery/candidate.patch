+        s.add(h);s.flush()
+        s.add(Asset(id='image_a',homework_id='hw',revision=1,document={'id':'image_a','status':'uploaded','sha256':IMAGE_SHA,'byte_size':len(IMAGE)}))
+        rows=[];owned=[]
+        for index in range(targets):
+            key=f'target_{index}';label=str(index+1);qid=f'q{index}';aid=f'a{index}';cid=f'c{index}'
+            raw={'label':label,'stem_text':'(-12)÷3=____(12÷3)=____','options':[],'answer_text':'4','answer_status':'present','uncertainties':[], 'visible_locator':{'printed_label':label,'page_zone':'top_left'}}
+            sources=[deepcopy(raw),deepcopy(raw)];ids=[source_id(role,v) for role,v in zip(('primary','secondary'),sources)]
+            qdoc={'question_id':qid,'revision':1,'label':label,'stem_text':raw['stem_text'],'options':[], 'regions':[{'asset_id':'image_a'}]}
+            adoc={'id':aid,'revision':1,'case_id':cid,'question_id':qid,'asset_ids':['image_a'],'recognition_revision':1,'answer_text':'4','answer_status':'present','recognition_status':'needs_revision'}
+            cdoc={'id':cid,'revision':1,'question_id':qid,'current_question_revision':1,'current_attempt_id':aid,'lifecycle':'active','current_decision':{'id':f'd{index}','revision':1,'origin':'model','validity':'needs_review','verdict':'unable_to_judge','case_id':cid,'attempt_id':aid}}
+            s.add(Entity(id=f'd{index}',homework_id='hw',kind='decision',revision=1,document=cdoc['current_decision']))
+            s.add_all([Entity(id=qid,homework_id='hw',kind='question',revision=1,document=qdoc,annotations={'label':label,'visible_locator':raw['visible_locator']}),Entity(id=aid,homework_id='hw',kind='attempt',revision=1,document=adoc),Entity(id=cid,homework_id='hw',kind='case',revision=1,document=cdoc)])
+            rows.append({'target_key':key,'case_id':cid,'baseline_sources':sources,'baseline_source_ids':ids})
+            owned.append({'target_key':key,'canonical_label':label,'source_ids':ids})
+        dispatches=[{'receipt_ref':f'legacy_{i}','stage':'reconciliation','requested_target_keys':['normal_'+str(i)],'outcome':'returned'} for i in range(reviews)]
+        receipts=[{'receipt_id':d['receipt_ref'],'stage':d['stage'],'requested_target_keys':d['requested_target_keys'],'state':'returned'} for d in dispatches]
+        route={'protocol':ROUTE_PROTOCOL,'asset_id':'image_a','image_sha256':IMAGE_SHA,'parent_execution_number':1,
+               'policy':deepcopy(POLICY),'scope_owned':owned,'legacy_dispatches':dispatches,
