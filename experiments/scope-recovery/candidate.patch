+@pytest.mark.parametrize("legacy_shared", [False, True])
+def test_current_observation_only_withdrawal_preserves_prior_evidence_and_staff(flow, legacy_shared):
+    seed = seed_scope(flow)
+    history = historical_evidence_fixture(seed, legacy_shared)
+    dispatch_both(start(seed))
+    result = apply(seed)
+    assert result["applied_count"] == 1
+    with Session(flow.database.engine) as session:
+        assert session.get(Entity, seed.cases[0]["question_id"]).document == history["question"]
+        assert session.get(Entity, history["previous_attempt"]).document == history["previous_document"]
+        assert row_values(session.get(Entity, history["previous_decision"]["id"])) == history["previous_decision"]
+        for identifier, original in history["original_links"].items():
+            assert row_values(session.get(QuestionKnowledgeLink, identifier)) == original
+        previous_id, previous_key, previous_raw = history["evidence"][history["previous_attempt"]]
+        previous_evidence = session.get(LearningEvidence, previous_id)
+        assert previous_evidence.validity == "valid" and previous_evidence.source_key == previous_key
+        assert previous_evidence.document == previous_raw
+        current_id = history["evidence"][seed.cases[0]["current_attempt_id"]][0]
+        assert session.get(LearningEvidence, current_id).validity == "invalidated"
+        assert session.scalars(select(LearningEvidence.id).where(LearningEvidence.validity == "valid")).all() == [previous_id]
+        [change] = result["target_outcomes"]["target_0"]["withdrawn_knowledge_links"]
+        assert change["previous_link_id"] == history["current_link_id"]
+        withdrawal = session.get(QuestionKnowledgeLink, change["withdrawal_link_id"])
+        assert withdrawal.rationale.startswith("[recognition_revision_withdrawal:scope.v1]")
+        assert [b["attempt_id"] for b in withdrawal.observation_bindings] == [seed.cases[0]["current_attempt_id"]]
+        assert withdrawal.status == "candidate" and withdrawal.source == "model"
+        assert result["projection"]["invalidated"] == 1 and result["projection"]["added"] == 0
+        for _ in range(2):
+            again = project_student(session, "tenant_a", "student_a")
+            assert again["added"] == again["invalidated"] == 0
+        session.commit()
+        assert session.get(LearningEvidence, previous_id).document == previous_raw
+
