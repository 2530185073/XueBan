+"""Dedicated, isolated MockTransport scope-recovery consumer.
+
+Not registered with the production worker. The only entry is a persisted child
+Task plus its owner lease; callers cannot supply an application plan or proof.
+All business writes and the final task CAS share the caller's transaction.
+"""
+from copy import deepcopy
+import hashlib
+
+from sqlalchemy import select, update
+from sqlalchemy.exc import OperationalError
+
+from .correction_core import (assets_for, input_versions, invalidate, iso, new_id,
+                              save_entity, update_case)
+from .correction_models import Entity
+from .learning_mapping import (inherit_staff_links_for_unchanged_question,
+                               withdraw_model_links_for_recognition)
+from .learning_models import QuestionKnowledgeLink
+from .learning_projection import project_student
+from .providers import answer_scope
+from .providers.scope_recovery_materializer import prepare_application
+from .providers.whole_page import normalize_page_stem
+from .scope_recovery import DurableScope, Rejected
+
+PROTOCOL = "scope-apply.mock.v1"
+
+
+def _locked_entities(session, homework, targets):
+    question_ids = sorted({row["question_id"] for row in targets})
+    other_ids = sorted({identifier for row in targets for identifier in (
+        row["case_id"], row["attempt_id"], row["current_decision"]["id"])})
+    rows = {}
+    # Teachers and recognition use the question lock after the same Student
+    # entry lock. Read all target entities freshly before checking versions.
+    for identifiers in (question_ids, other_ids):
+        for row in session.scalars(select(Entity).where(Entity.homework_id == homework.id,
+                Entity.id.in_(identifiers)).order_by(Entity.id).with_for_update()
+                .execution_options(populate_existing=True)):
+            rows[row.id] = row
+    return rows
+
+
+def _question_note_mode(session, homework, target, rows):
+    question, case = rows[target["question_id"]], rows[target["case_id"]]
+    notes = question.document.get("recognition_uncertainties", [])
+    if not notes:
+        return "unchanged"
+    old_decision = rows[target["current_decision"]["id"]].document
+    sources = target["baseline_sources"]
+    raw_sources = [item["observation"] if "observation" in item else item for item in sources]
+    if (notes != [answer_scope.SUMMARY]
+            or any(source.get("uncertainties", []) for source in raw_sources)
+            or old_decision.get("origin") != "model"
+            or (old_decision.get("verification") or {}).get("reason_codes") != [answer_scope.REASON]):
+        return "unrelated_question_uncertainty"
+    siblings = list(session.scalars(select(Entity).where(Entity.homework_id == homework.id,
+        Entity.kind == "case")))
+    siblings = [row for row in siblings if row.document.get("lifecycle") == "active"
+                and row.document.get("question_id") == question.id]
+    if (case.document.get("attempt_ids") != [target["attempt_id"]]
+            or len(siblings) != 1 or siblings[0].id != case.id):
+        return "question_note_migration_required"
+    return "clear_scope_placeholder"
+
+
+def _cas_rows(session, homework_id, rows):
+    # A no-op revision CAS acquires SQLite's write serialization too. Existing
+    # Entity helpers create immutable snapshots only for the real changes below.
+    for row in rows:
+        try:
+            changed = session.execute(update(Entity).where(Entity.id == row.id,
+                Entity.homework_id == homework_id, Entity.kind == row.kind, Entity.revision == row.revision)
+                .values(revision=row.revision).execution_options(synchronize_session=False))
+        except OperationalError:
+            raise Rejected("concurrent_entity_change") from None
+        if changed.rowcount != 1:
+            raise Rejected("concurrent_entity_change")
+
+
+def _scope_rationales(session, changed, id_field, old_prefix, new_prefix):
+    """Only newly appended rows get an accurate protocol name; old rows stay intact."""
+    for item in changed:
+        row = session.get(QuestionKnowledgeLink, item[id_field])
+        if row is None or not row.rationale.startswith(old_prefix):
+            raise Rejected("learning_withdrawal_contract_changed")
+        row.rationale = new_prefix + row.rationale[len(old_prefix):]
+
+
+def _apply_target(session, contracts, task, homework, target, plan, rows, snapshot, reviewed, note_mode):
+    question, attempt, case, old_decision = [rows[identifier] for identifier in (
+        target["question_id"], target["attempt_id"], target["case_id"], target["current_decision"]["id"])]
+    _cas_rows(session, homework.id, (question, attempt, case, old_decision))
+    assets = assets_for(session, homework.id, list(dict.fromkeys(
+        [region["asset_id"] for region in question.document["regions"]] + attempt.document["asset_ids"])))
+    before_versions = input_versions(case, question, attempt, assets)
+    old_attempt = deepcopy(attempt.document)
+    old_question = deepcopy(question.document)
+    withdrawn = withdraw_model_links_for_recognition(session, question, homework,
+        attempt_id=attempt.id, recognition_revision=attempt.document["recognition_revision"], job_id=task.id)
+    _scope_rationales(session, withdrawn, "withdrawal_link_id", "[recognition_revision_withdrawal:r1]",
+                     "[recognition_revision_withdrawal:scope.v1]")
+    invalidate(session, contracts, case, "model_recognition_revision")
+    inherited = []
+    if note_mode == "clear_scope_placeholder":
+        # Only exact host-generated scope status, never arbitrary image notes.
+        document = {**question.document, "revision": question.revision + 1, "recognition_uncertainties": []}
+        save_entity(session, contracts, homework.id, "question", document, row=question)
+        inherited = inherit_staff_links_for_unchanged_question(session, question, old_question, job_id=task.id)
+        _scope_rationales(session, inherited, "inherited_link_id", "[recognition_notes_inheritance:r1]",
+                         "[recognition_notes_inheritance:scope.v1]")
+    observation = plan["attempt_fields"]
+    document = {**attempt.document, "revision": attempt.revision + 1,
+        "recognition_revision": attempt.document["recognition_revision"] + 1,
+        "answer_text": observation["answer_text"], "answer_status": observation["answer_status"],
+        "recognition_uncertainties": [], "recognition_status": "ready"}
+    save_entity(session, contracts, homework.id, "attempt", document, row=attempt)
+    source_trace = {"protocol": PROTOCOL, "task_id": task.id, "target_key": target["target_key"],
+        "input_snapshot_sha256": snapshot.sha256, "source_id": plan["source_id"],
+        "review_archive_sha256": reviewed.sha256, "position_bindings": deepcopy(plan["position_bindings"]),
+        "question_revision": question.revision, "attempt_recognition_revision": document["recognition_revision"],
+        "transport_kind": "httpx_mock", "independent_judgments": 1,
+        "blind_read_semantics": "one_actual_mock_blind_read_followed_by_informed_review_not_two_model_consensus"}
+    annotations = deepcopy(attempt.annotations or {})
+    annotations.update(answer_status=observation["answer_status"], target_binding="typed_scope_recovery",
+                       recognition_origin={"protocol": PROTOCOL, "job_id": task.id}, scope_recovery=source_trace)
+    # Existing answer_slots and their historical revision binding are retained;
+    # they must not masquerade as the newly typed position protocol.
+    attempt.annotations = annotations
+    update_case(session, contracts, case, current_question_revision=question.revision, current_decision=None)
+    versions = input_versions(case, question, attempt, assets)
+    check_id, decision_id, timestamp = new_id("check"), new_id("decision"), iso()
+    read_slot, review_slot = [task.audit["scope_stages"][stage] for stage in ("read", "review")]
+    check = {"id": check_id, "revision": 1, "job_id": task.id, "case_id": case.id,
+        "input_versions": versions, "model_version": review_slot["validation_receipt"]["model"],
+        "rule_version": None, "prompt_version": "typed-scope-recovery.v1-candidate",
+        "decision_ids": [decision_id], "created_at": timestamp}
+    check_row = save_entity(session, contracts, homework.id, "check", check)
+    decision = {**deepcopy(plan["decision_fields"]), "id": decision_id, "revision": 1,
+        "check_id": check_id, "input_versions": versions, "created_at": timestamp,
+        "validity": "candidate", "verification": {
+            # Derived only after validated_protocol checked actual MockTransport
+            # wire events + receipts. Does NOT claim two independent model votes.
+            "mode": "single", "status": "reviewed", "independent_readback": True, "reason_codes": []}}
+    decision["basis"] = [{"kind": "model_hypothesis", "summary":
+        "原图盲读与逐位置复核的模型候选，位置和原文引用已绑定；不是老师确认或两路模型共识。",
+        "source_ref": plan["source_id"], "regions": []}]
+    decision_row = save_entity(session, contracts, homework.id, "decision", decision)
+    trace = {**source_trace, "read_receipt_id": read_slot["receipt"]["receipt_id"],
+        "review_receipt_id": review_slot["receipt"]["receipt_id"],
+        "host_wire_receipts": {stage: deepcopy(task.audit["scope_stages"][stage]["wire"]) for stage in ("read", "review")}}
+    check_row.annotations = deepcopy(trace); decision_row.annotations = deepcopy(trace)
+    progress = "paused" if case.document["progress"] == "paused" else (
+        "pending" if decision["verdict"] == "correct" else "needs_correction")
+    update_case(session, contracts, case, current_decision=decision,
+                check_ids=case.document["check_ids"] + [check_id], progress=progress)
+    return {"status": "applied", "case_id": case.id, "question_id": question.id, "attempt_id": attempt.id,
+        "decision_id": decision_id, "check_id": check_id, "source_id": plan["source_id"],
+        "before": before_versions, "after": versions,
+        "attempt_revision_before": old_attempt["revision"], "attempt_revision_after": attempt.revision,
+        "question_revision_before": old_question["revision"], "question_revision_after": question.revision,
+        "withdrawn_knowledge_links": withdrawn, "inherited_staff_knowledge_links": inherited}
+
+
+def apply_scope_recovery(session, contracts, task_id, *, owner_lease_token):
+    """Apply saved Mock evidence atomically; caller commits/rolls back the session."""
+    store = DurableScope(session.get_bind())
+    parent, homework, task = store.locked_apply_context(session, task_id, owner_lease_token)
+    previous = (task.audit or {}).get("scope_application")
+    if task.status == "succeeded" and isinstance(previous, dict):
+        return deepcopy(previous)
+    snapshot, readback, reviewed = store.validated_protocol(task)
+    slots = task.audit["scope_stages"]
+    # This isolated consumer has no real-provider execution provenance yet.
+    if any(slot.get("wire", {}).get("protocol") != "scope-wire.mock.v1"
+           or slot.get("wire", {}).get("transport_kind") != "httpx_mock" for slot in slots.values()):
+        raise Rejected("unsupported_wire_provenance")
+    plan = prepare_application(snapshot,
+        read_receipt=slots["read"]["validation_receipt"], read_raw_json=slots["read"]["raw_final"],
+        review_receipt=slots["review"]["validation_receipt"], review_raw_json=slots["review"]["raw_final"]).payload()
+    targets = snapshot.payload()["targets"]
+    rows = _locked_entities(session, homework, targets)
+    current, stale = store._current_targets(session, homework, task)
+    outcomes = {}
+    for target in targets:
+        key = target["target_key"]
+        if key not in current:
+            outcomes[key] = {"status": "stale_input", "reason": stale.get(key, "target_unavailable")}
+            continue
+        proposal = plan["targets"][key]
+        if proposal["state"] != "prepared_application":
+            outcomes[key] = {"status": "ai_pending", "reason": "typed_materialization_unresolved", "errors": proposal["errors"]}
+            continue
+        question = rows[target["question_id"]]
+        if (normalize_page_stem({"stem_text": question.document["stem_text"], "label": (question.annotations or {}).get("label")})
+                != normalize_page_stem({"stem_text": proposal["question_fields"]["stem_text"], "label": target["locator"]["printed_label"]})
+                or question.document.get("options", []) != proposal["question_fields"]["options"]):
+            outcomes[key] = {"status": "ai_pending", "reason": "printed_question_change_not_supported"}
+            continue
+        note_mode = _question_note_mode(session, homework, target, rows)
+        if note_mode not in {"unchanged", "clear_scope_placeholder"}:
+            outcomes[key] = {"status": "ai_pending", "reason": note_mode}
+            continue
+        outcomes[key] = _apply_target(session, contracts, task, homework, target, proposal,
+                                      rows, snapshot, reviewed, note_mode)
+    applied = sum(value["status"] == "applied" for value in outcomes.values())
+    projection = project_student(session, homework.tenant_id, homework.student_id) if applied else {"status": "not_needed"}
+    result = {"protocol": PROTOCOL, "target_outcomes": outcomes, "applied_count": applied,
+        "projection": projection, "plan_sha256": materializer_digest(plan),
+        "owner_lease_digest": hashlib.sha256(owner_lease_token.encode()).hexdigest(),
+        "source": "isolated_mock_vertical", "real_model_requests": 0}
+    store.finish_applied(session, task, audit_updates={"scope_application": result})
+    return deepcopy(result)
+
+
+def materializer_digest(plan):
+    from .providers.scope_recovery_contract import digest
+    return digest(plan)
