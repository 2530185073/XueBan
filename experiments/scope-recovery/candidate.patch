+"""Real mock HTTP boundaries, synthetic data only; never a paid model test."""
+from copy import deepcopy
+import hashlib
+import json
+
+import httpx
+import pytest
+
+from xueban_backend.providers.ark import ProviderError
+from xueban_backend.providers.bounded_chat import BoundedChatClient
+from xueban_backend.scope_recovery import Rejected
+from xueban_backend.scope_recovery_dispatch import MockScopeDispatcher
+from test_scope_recovery_durable import setup_child, read_raw, review_raw
+
+
+def envelope(content, *, model="synthetic-scope-model", finish="stop"):
+    return {"id": "mock_scope_response", "model": model,
+            "choices": [{"finish_reason": finish, "message": {"content": content}}],
+            "usage": {"prompt_tokens": 11, "completion_tokens": 6, "total_tokens": 17}}
+
+
+def test_actual_two_http_boundaries_store_bound_receipts_without_applying(database):
+    store, _, child, token = setup_child(database)
+    calls, bodies = [], []
+    def handler(request):
+        body = json.loads(request.content)
+        data = json.loads(body["messages"][1]["content"][0]["text"])
+        # A blind request carries locators only, not old answers or counts.
+        if not calls:
+            assert set(data) == {"targets"}
+            assert all(set(row) == {"target_key", "locator"} for row in data["targets"])
+            output = read_raw(store, child)
+        else:
+            assert all("source_id" in row for row in data["targets"])
+            output = review_raw(store, child)
+        calls.append(request.content)
+        response = httpx.Response(200, json=envelope(output))
+        bodies.append(response.content)
+        return response
+    dispatcher = MockScopeDispatcher(store, httpx.MockTransport(handler))
+    for stage in ("read", "review"):
+        outcome = dispatcher.dispatch(child, token, stage)
+        assert outcome["recorded"] and not outcome["late"]
+    state = store.inspect(child)
+    assert len(calls) == 2 and state["status"] == "running"
+    for index, stage in enumerate(("read", "review")):
+        slot = state["audit"]["scope_stages"][stage]
+        assert slot["wire"]["request_body_sha256"] == hashlib.sha256(calls[index]).hexdigest()
+        assert slot["response_trace"]["response_body_sha256"] == hashlib.sha256(bodies[index]).hexdigest()
+        assert slot["response_trace"]["canonical_final_sha256"] == hashlib.sha256(slot["raw_final"].encode()).hexdigest()
+        assert slot["metadata"]["usage"]["total_tokens"] == 17
+    assert "data:image" not in json.dumps(state["audit"])
+    assert "synthetic-scope-key" not in json.dumps(state)
+    with pytest.raises((Rejected, ProviderError)):
+        dispatcher.dispatch(child, token, "read")
+    assert len(calls) == 2
+
+
+def test_non_mock_transport_is_refused_without_network(database):
+    store, _, _, _ = setup_child(database)
+    with pytest.raises(ValueError, match="mock_transport_required"):
+        MockScopeDispatcher(store, object())
+
+
+def test_changed_asset_bytes_consume_no_slot_or_http_call(database):
+    store, _, child, token = setup_child(database)
+    store.asset_reader = lambda *args: b"changed"
+    calls = []
+    dispatcher = MockScopeDispatcher(store, httpx.MockTransport(lambda request: calls.append(request)))
+    with pytest.raises(ProviderError, match="image_integrity_mismatch"):
+        dispatcher.dispatch(child, token, "read")
+    assert not calls and store.inspect(child)["audit"]["scope_stages"]["read"]["status"] == "available"
+
+
+def test_nearly_expired_lease_does_not_start_another_http_request(database):
+    store, clock, child, token = setup_child(database)
+    clock.advance(119.5)
+    calls = []
+    with pytest.raises(ProviderError, match="deadline_exceeded"):
+        MockScopeDispatcher(store, httpx.MockTransport(lambda request: calls.append(request))).dispatch(child, token, "read")
+    assert not calls and store.inspect(child)["audit"]["scope_stages"]["read"]["status"] == "available"
+
+
+@pytest.mark.parametrize("status,content,finish", [(503, "{}", "stop"), (200, "invalid", "stop"),
+    (200, "{}", "length"), (200, '{"targets":[],"targets":[{}]}', "stop")])
+def test_failed_call_is_not_retried_or_given_typed_authority(database, status, content, finish):
+    store, _, child, token = setup_child(database)
+    calls = []
+    def handler(request):
+        calls.append(request.content)
+        return httpx.Response(status, json=envelope(content, finish=finish))
+    dispatcher = MockScopeDispatcher(store, httpx.MockTransport(handler))
+    dispatcher.dispatch(child, token, "read")
+    state = store.inspect(child)
+    assert state["status"] == "failed" and len(calls) == 1
+    slot = state["audit"]["scope_stages"]["read"]
+    assert slot.get("typed_validation") is None and slot.get("raw_final") is None
+    assert slot["metadata"]["attempts"][0]["status_code"] == status
+    if status == 200:
+        assert slot["metadata"]["attempts"][0]["usage"]["total_tokens"] == 17
+    with pytest.raises((Rejected, ProviderError)):
+        dispatcher.dispatch(child, token, "read")
+    assert len(calls) == 1
+
+
+@pytest.mark.parametrize("location", ["answer", "metadata"])
+def test_other_provider_secret_echo_is_never_persisted(database, location):
+    store, _, child, token = setup_child(database)
+    secret = "other_provider_synthetic_secret"
+    def handler(request):
+        raw = json.loads(read_raw(store, child))
+        if location == "answer":
+            raw["targets"][0]["observation"]["answer_text"] = secret
+        return httpx.Response(200, json=envelope(json.dumps(raw),
+                            model=secret if location == "metadata" else "synthetic-scope-model"))
+    MockScopeDispatcher(store, httpx.MockTransport(handler), provider_secrets=(secret,)).dispatch(child, token, "read")
+    state = store.inspect(child)
+    assert state["status"] == "failed" and secret not in json.dumps(state)
+    slot = state["audit"]["scope_stages"]["read"]
+    assert slot.get("raw_final") is None and slot["metadata"]["attempts"][0]["code"] == "provider_credential_echo"
+    assert slot["metadata"]["attempts"][0]["usage"]["total_tokens"] == 17
+
+
+def test_identical_duplicate_key_is_canonicalized_with_diagnostic(database):
+    store, _, child, token = setup_child(database)
+    output = read_raw(store, child).replace('"coverage": "complete"', '"coverage": "complete", "coverage": "complete"')
+    MockScopeDispatcher(store, httpx.MockTransport(lambda request: httpx.Response(200, json=envelope(output)))).dispatch(child, token, "read")
+    slot = store.inspect(child)["audit"]["scope_stages"]["read"]
+    assert slot["metadata"]["attempts"][0]["diagnostic"]["rule"] == "identical_duplicate_keys_removed"
+    assert slot["typed_validation"]["targets"]["target_0"]["state"] == "pending_scope_review"
+
+
+def test_payload_changed_after_reservation_never_reaches_inner_mock(database, monkeypatch):
+    store, _, child, token = setup_child(database)
+    calls = []
+    original = BoundedChatClient._generate
+    def mutate(self, body, *args):
+        changed = deepcopy(body)
+        changed["messages"][1]["content"] = changed["messages"][1]["content"][:1]
+        return original(self, changed, *args)
+    monkeypatch.setattr(BoundedChatClient, "_generate", mutate)
+    MockScopeDispatcher(store, httpx.MockTransport(lambda request: calls.append(request))).dispatch(child, token, "read")
+    state = store.inspect(child)
+    assert not calls and state["status"] == "failed"
+    assert "wire" not in state["audit"]["scope_stages"]["read"]
