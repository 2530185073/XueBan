  "components": {
    "schemas": {
      "AttemptIn": {
        "properties": {
          "idempotency_key": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Idempotency Key"
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Revision"
          },
          "question_id": {
            "type": "string",
            "title": "Question Id"
          },
          "answer": {
            "type": "string",
            "maxLength": 2000,
            "title": "Answer"
          },
          "occurred_at": {
            "type": "string",
            "title": "Occurred At"
          },
          "stage": {
            "type": "string",
            "enum": [
              "homework",
              "correction",
              "practice",
              "assessment",
              "preview"
            ],
            "title": "Stage",
            "default": "practice"
          },
          "assistance": {
            "type": "string",
            "enum": [
              "none",
              "hint",
              "answer_seen"
            ],
            "title": "Assistance",
            "default": "none"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "idempotency_key",
          "expected_revision",
          "question_id",
          "answer",
          "occurred_at"
        ],
        "title": "AttemptIn"
      },
      "Command": {
        "properties": {
          "idempotency_key": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Idempotency Key"
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Revision"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "idempotency_key",
          "expected_revision"
        ],
        "title": "Command"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
