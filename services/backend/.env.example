# Replace with the dedicated PostgreSQL connection provided by deployment.
# No default account or password is included.
DATABASE_URL=

# Production OIDC access-token issuer and this API's audience.
OIDC_ISSUER=
OIDC_AUDIENCE=
# Configure exactly one: trusted HTTPS JWKS endpoint or mounted public PEM.
OIDC_JWKS_URL=
JWT_PUBLIC_KEY_FILE=

# Empty means no cross-origin allowlist; never use *.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# SQLite is only for explicitly selected local tests, never production.
ALLOW_SQLITE_FOR_TESTS=0

# Optional when the contract bundle is mounted at a deployment-specific location.
CONTRACTS_DIR=

# Explicit operator/worker configuration; never sent to Android or staff Web.
# The API app does not instantiate providers yet. ark_smoke reads these 3 keys.
# Empty base URL/key keeps the provider disabled. Supply base /api/v3, not the
# full /chat/completions path. Selected platform: BytePlus ModelArk AP.
ARK_BASE_URL=
ARK_API_KEY=
ARK_MODEL=deepseek-v4-1-flash-260910

# EmbeddingClient uses the same verified base/key when explicitly constructed;
# its separate model is skylark-embedding-vision-251215, default 2048 dimensions.
