# Replace with the dedicated PostgreSQL connection provided by deployment.
# No default account or password is included.
DATABASE_URL=

# Production OIDC access-token issuer and this API's audience.
OIDC_ISSUER=
OIDC_AUDIENCE=
# Configure exactly one: trusted HTTPS JWKS endpoint or mounted public PEM.
OIDC_JWKS_URL=
JWT_PUBLIC_KEY_FILE=

# Optional first-party device pairing; private RSA key stays outside the repo.
SIGNING_PRIVATE_KEY_FILE=
DEVICE_SESSION_TTL_SECONDS=28800

# Private local object storage shared by API and Worker; not a static directory.
ASSET_STORAGE_DIR=
PUBLIC_BASE_URL=http://127.0.0.1:8000
UPLOAD_TICKET_TTL_SECONDS=900
WORKER_LEASE_SECONDS=300

# Empty means no cross-origin allowlist; never use *.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# SQLite is only for explicitly selected local tests, never production.
ALLOW_SQLITE_FOR_TESTS=0

# Optional when the contract bundle is mounted at a deployment-specific location.
CONTRACTS_DIR=

# Explicit operator/worker configuration; never sent to Android or staff Web.
# The persistent Worker constructs the provider. The API does not call models.
# Empty base URL/key keeps the provider disabled. Supply base /api/v3, not the
# full /chat/completions path. Selected platform: BytePlus ModelArk AP.
ARK_BASE_URL=
ARK_API_KEY=
ARK_MODEL=deepseek-v4-1-flash-260910

# Optional whole-page two-reader mode; gateway credentials remain Worker-only.
# Explicit protocol avoids sending a Chat-only model to /responses.
# CORRECTION_MODE=two_model
# Optional persisted, unverified first-read text for ordinary homework jobs.
# Default off; enable in API and Worker, with VITE_READ_CHECKPOINT_ENABLED=1
# when building student-web. This does not enable interrupted-task recovery.
# READ_CHECKPOINT_ENABLED=0
# ZYAI_BASE_URL=
# ZYAI_API_KEY=
# REVIEW_MODEL=glm-5.3
# REVIEW_API=chat
# REVIEW_THINKING=disabled
# RECONCILIATION_PROVIDER=primary
# VISUAL_REVIEW_MODEL=gpt-6-astra
# VISUAL_REVIEW_ENABLED=1
# For GPT: REVIEW_MODEL=gpt-6-astra, REVIEW_API=responses,
# REVIEW_THINKING=enabled. Reconciliation is informed review, not a third vote.

# EmbeddingClient uses the same verified base/key when explicitly constructed;
# its separate model is skylark-embedding-vision-251215, default 2048 dimensions.
