{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xueban.invalid/evals/correction/common.schema.json",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "nullable_string": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "versions": {
      "type": "object",
      "properties": {
        "question_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
        },
        "question_revision": {
          "type": "integer",
          "minimum": 1
        },
        "attempt_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
        },
        "attempt_recognition_revision": {
          "type": "integer",
          "minimum": 1
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "question_id",
        "question_revision",
        "attempt_id",
        "attempt_recognition_revision",
        "fingerprint"
      ],
      "additionalProperties": false
    },
    "split": {
      "enum": [
        "development",
        "calibration",
        "holdout"
      ]
    },
    "verdict": {
      "enum": [
        "correct",
        "incorrect",
        "partially_correct",
        "unanswered"
      ]
    },
    "cost": {
      "type": "object",
      "properties": {
        "amount": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "currency": {
          "enum": [
            "CNY",
            "USD",
            null
          ]
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "amount": {
                "type": "number"
              }
            }
          },
          "then": {
            "properties": {
              "currency": {
                "enum": [
                  "CNY",
                  "USD"
                ]
              }
            }
          }
        }
      ]
    }
  }
}
