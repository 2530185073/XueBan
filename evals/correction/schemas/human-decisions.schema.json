{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xueban.invalid/evals/correction/human-decisions.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "dataset_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "dataset_version": {
      "type": "string",
      "minLength": 1
    },
    "synthetic_only": {
      "type": "boolean"
    },
    "split": {
      "$ref": "common.schema.json#/$defs/split"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "output_kind": {
      "const": "human_final"
    },
    "applies_to_model_run_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sample_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
          },
          "input_versions": {
            "$ref": "common.schema.json#/$defs/versions"
          },
          "decision_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
          },
          "outcome": {
            "enum": [
              "confirmed",
              "unresolved"
            ]
          },
          "verdict": {
            "anyOf": [
              {
                "$ref": "common.schema.json#/$defs/verdict"
              },
              {
                "type": "null"
              }
            ]
          },
          "reviewer_id": {
            "type": "string",
            "minLength": 1
          },
          "basis_ref": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "sample_id",
          "input_versions",
          "decision_id",
          "outcome",
          "verdict",
          "reviewer_id",
          "basis_ref"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "outcome": {
                  "const": "confirmed"
                }
              }
            },
            "then": {
              "properties": {
                "verdict": {
                  "$ref": "common.schema.json#/$defs/verdict"
                }
              }
            },
            "else": {
              "properties": {
                "verdict": {
                  "type": "null"
                }
              }
            }
          }
        ]
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "dataset_id",
    "dataset_version",
    "synthetic_only",
    "split",
    "run_id",
    "output_kind",
    "applies_to_model_run_id",
    "decisions"
  ],
  "additionalProperties": false
}
