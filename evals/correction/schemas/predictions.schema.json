{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xueban.invalid/evals/correction/predictions.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "dataset_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "dataset_version": {
      "type": "string",
      "minLength": 1
    },
    "synthetic_only": {
      "type": "boolean"
    },
    "split": {
      "$ref": "common.schema.json#/$defs/split"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "output_kind": {
      "const": "model_candidate"
    },
    "provenance": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "model_version": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "version_unknown_reason": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "adapter_version": {
          "type": "string",
          "minLength": 1
        },
        "request_config_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "provider",
        "model",
        "model_version",
        "version_unknown_reason",
        "adapter_version",
        "request_config_sha256"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "model_version": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "version_unknown_reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "requests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "request_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
          },
          "sample_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "latency_ms": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "cost": {
            "$ref": "common.schema.json#/$defs/cost"
          },
          "raw_response_ref": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          }
        },
        "required": [
          "request_id",
          "sample_ids",
          "latency_ms",
          "cost",
          "raw_response_ref"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "predictions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sample_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
          },
          "input_versions": {
            "$ref": "common.schema.json#/$defs/versions"
          },
          "request_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "outcome": {
            "enum": [
              "candidate",
              "unrecognized",
              "unable_to_judge",
              "technical_failure",
              "missing_detection",
              "no_output"
            ]
          },
          "verdict": {
            "anyOf": [
              {
                "$ref": "common.schema.json#/$defs/verdict"
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          }
        },
        "required": [
          "sample_id",
          "input_versions",
          "request_ids",
          "outcome",
          "verdict",
          "reason"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "outcome": {
                  "const": "candidate"
                }
              }
            },
            "then": {
              "properties": {
                "verdict": {
                  "$ref": "common.schema.json#/$defs/verdict"
                },
                "request_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
                  },
                  "minItems": 1
                }
              }
            },
            "else": {
              "properties": {
                "verdict": {
                  "type": "null"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "dataset_id",
    "dataset_version",
    "synthetic_only",
    "split",
    "run_id",
    "output_kind",
    "provenance",
    "requests",
    "predictions"
  ],
  "additionalProperties": false
}
