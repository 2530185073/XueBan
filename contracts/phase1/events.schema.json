        },
        "schema_version": {
          "const": "phase1.event.v1"
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "scope": {
          "$ref": "data.schema.json#/$defs/Scope"
        },
        "aggregate_type": {
          "const": "case"
        },
        "aggregate_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{2,63}$"
        },
        "aggregate_revision": {
          "type": "integer",
          "minimum": 1
        },
        "payload": {
          "type": "object",
          "properties": {
            "review_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{2,63}$"
            },
            "target_decision_id": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]{2,63}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "new_decision_id": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]{2,63}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "review_id",
            "target_decision_id",
            "new_decision_id"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "event_id",
        "event_type",
        "schema_version",
        "occurred_at",
        "scope",
        "aggregate_type",
        "aggregate_id",
        "aggregate_revision",
        "payload"
      ],
      "additionalProperties": false
    },
    "deletion.requested": {
      "type": "object",
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{2,63}$"
        },
        "event_type": {
          "const": "deletion.requested"
        },
        "schema_version": {
          "const": "phase1.event.v1"
        },
        "occurred_at": {
          "type": "string",
