        },
        "aggregate_type": {
          "const": "student"
        },
        "aggregate_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{2,63}$"
        },
        "aggregate_revision": {
          "type": "integer",
          "minimum": 1
        },
        "payload": {
          "type": "object",
          "properties": {
            "deletion_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{2,63}$"
            }
          },
          "required": [
            "deletion_id"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "event_id",
        "event_type",
        "schema_version",
        "occurred_at",
        "scope",
        "aggregate_type",
        "aggregate_id",
        "aggregate_revision",
        "payload"
      ],
      "additionalProperties": false
    },
    "deletion.completed": {
      "type": "object",
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{2,63}$"
        },
        "event_type": {
          "const": "deletion.completed"
        },
        "schema_version": {
          "const": "phase1.event.v1"
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "scope": {
          "$ref": "data.schema.json#/$defs/Scope"
        },
        "aggregate_type": {
          "const": "student"
        },
        "aggregate_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{2,63}$"
        },
        "aggregate_revision": {
          "type": "integer",
          "minimum": 1
        },
        "payload": {
          "type": "object",
          "properties": {
            "deletion_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{2,63}$"
            }
          },
          "required": [
            "deletion_id"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "event_id",
        "event_type",
        "schema_version",
        "occurred_at",
        "scope",
        "aggregate_type",
        "aggregate_id",
        "aggregate_revision",
        "payload"
      ],
      "additionalProperties": false
    },
    "Event": {
      "oneOf": [
        {
          "$ref": "events.schema.json#/$defs/question.revised"
        },
        {
          "$ref": "events.schema.json#/$defs/attempt.created"
        },
        {
          "$ref": "events.schema.json#/$defs/decision.created"
        },
        {
          "$ref": "events.schema.json#/$defs/decision.invalidated"
        },
        {
          "$ref": "events.schema.json#/$defs/review.recorded"
        },
        {
          "$ref": "events.schema.json#/$defs/deletion.requested"
        },
        {
          "$ref": "events.schema.json#/$defs/deletion.completed"
        },
        {
          "$ref": "events.schema.json#/$defs/layout.revised"
        }
      ]
    },
    "layout.revised": {
      "type": "object",
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{2,63}$"
        },
        "event_type": {
          "const": "layout.revised"
        },
        "schema_version": {
          "const": "phase1.event.v1"
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
