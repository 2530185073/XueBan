          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{2,63}$"
        },
        "aggregate_revision": {
          "type": "integer",
          "minimum": 1
        },
        "payload": {
          "type": "object",
          "properties": {
            "job_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{2,63}$"
            },
            "superseded_question_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{2,63}$"
              },
              "minItems": 0
            },
            "created_question_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{2,63}$"
              },
              "minItems": 1
            }
          },
          "required": [
            "job_id",
            "superseded_question_ids",
            "created_question_ids"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "event_id",
        "event_type",
        "schema_version",
        "occurred_at",
        "scope",
        "aggregate_type",
        "aggregate_id",
        "aggregate_revision",
        "payload"
      ],
      "additionalProperties": false
