# Copy to infra/model.env (not committed, chmod 600). Read by the worker only;
# the API container never receives model credentials.
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
ARK_API_KEY=
ARK_MODEL=deepseek-v4-1-flash-260910
# Opt in after configuring the independent image reader and dispute reviewer.
CORRECTION_MODE=single
ZYAI_BASE_URL=https://api.zyai.online/v1
ZYAI_API_KEY=
READBACK_MODEL=kimi-k3
REVIEW_MODEL=gpt-6-astra
