# Copy to infra/model.env (not committed, chmod 600). Read by the worker only;
# the API container never receives model credentials.
ARK_BASE_URL=https://api.zyai.online/v1
ARK_API_KEY=
ARK_MODEL=deepseek-v4-1-flash-260910
# Restored user flow from d519e3b: full-page recognition, then per-question
# judgment, with Astra review/fallback. Only the worker receives these keys.
CORRECTION_MODE=user_original
ZYAI_BASE_URL=https://api.zyai.online/v1
ZYAI_API_KEY=
ARK_FALLBACK_MODEL=gpt-6-astra
# Astra has its own key; it does not inherit ARK_API_KEY.
